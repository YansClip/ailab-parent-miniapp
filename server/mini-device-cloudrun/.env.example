# Public identifiers are known; secrets are intentionally empty.
MINI_APP_ID=wxc5abf3407ed4ef30
WX_CLOUDRUN_ENV=prod-d4gzywf6m065e947c
PORT=8080
HOST=127.0.0.1
# Set true ONLY after platform network settings have been verified: public
# domain/CUSTOM domains/other untrusted ingress closed, only callContainer.
# This is NOT a signature or an automatic network switch.
WX_GATEWAY_ONLY_CONFIRMED=false
# Identity can work without DB. Device/private data operations cannot.
STORAGE_DRIVER=disabled
# Private business service: no public ingress, uses trusted WeChat gateway.
# Separate location-ingress service: HTTPS + HMAC; no WeChat business routes.
SERVICE_ROLE=business
LOCATION_PROVIDER=disabled
# Set push ONLY after authenticated relay, database and real binding are ready.
# Separate ingress only: array of {keyId,secret,deviceIds}; never put keys in Git.
LOCATION_RELAY_KEYS_JSON=
# Optional, separate engineer-location receipt diagnostics; NOT formal GNSS.
# Off by default. Deploy/permission/billing confirmation is still required.
# Business role needs enabled/tests/readers/expiry; ingress needs enabled/tests/
# readers/expiry plus its OWN relay keys and SERVICE_ROLE=test-location-ingress.
TEST_LOCATION_ENABLED=false
# Array of exact {familyId,childId,deviceId,bindingVersion}; private config only.
TEST_LOCATION_TESTS_JSON=
# Explicit allowed OpenIDs; existing viewDevice/locateDevice grants also required.
TEST_LOCATION_READERS_JSON=
# ISO timestamp with timezone, never an indefinite test window.
TEST_LOCATION_EXPIRES_AT=
# Array of {keyId,secret,deviceIds}; never reuse formal-location credentials.
TEST_LOCATION_RELAY_KEYS_JSON=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TLS=true
MYSQL_CA_PEM=
# Only if cloud internal DB has no TLS; never permit plaintext public MySQL.
MYSQL_PRIVATE_NETWORK_CONFIRMED=false
VOIP_PROVIDER=disabled
THINGCONNECT_USER_URL=
THINGCONNECT_VOIP_URL=
PROVIDER_TIMEOUT_MS=8000
LOCATION_TTL_MS=
STATUS_TTL_MS=
WATCH_LEASE_MS=
LOCATION_POLL_MS=
LOCATION_REFRESH_TIMEOUT_MS=
CALL_INVITE_TIMEOUT_MS=
MAX_CALL_MS=
# This phase has no native callback/media server/public hardware endpoint.
# MEDIA_STATE_RELAY_READY and CALLBACK_PROTOCOL cannot enable real calls here.
