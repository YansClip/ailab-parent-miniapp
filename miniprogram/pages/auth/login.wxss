.page-has-footer { min-height: 100vh; }
.login-visual{height:390rpx;border-radius:42rpx;overflow:hidden;position:relative;margin-bottom:34rpx;box-shadow:0 16rpx 42rpx rgba(16,42,67,.12)}.login-visual>image,.login-mask{position:absolute;left:0;right:0;top:0;bottom:0;width:100%;height:100%}.login-mask{background:linear-gradient(180deg,transparent 45%,rgba(16,42,67,.68))}.login-tag{position:absolute;left:26rpx;bottom:24rpx;color:#fff;font-size:27rpx;font-weight:650}.trust-list{padding:24rpx;border-radius:30rpx;background:#fff}.trust-list>view{display:flex;align-items:center;gap:12rpx;margin-top:14rpx;color:#40566a;font-size:24rpx}.trust-list>view:first-child{margin-top:0}.trust-list image{width:30rpx;height:30rpx}
