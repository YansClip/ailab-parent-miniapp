.welcome {
  min-height: 100vh;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.hero-space { height: 48rpx; }
.copy { padding-right: 40rpx; }
.art {
  margin: 48rpx 0 40rpx;
  height: 420rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(16, 42, 67, 0.12);
}
.art-img { width: 100%; height: 100%; }
.actions { margin-top: auto; }
.join {
  width: 100%;
  background: transparent;
  line-height: 1.4;
  text-align: center;
  margin-top: 28rpx;
  color: #61758a;
  font-size: 28rpx;
}
