<view class="page page-has-footer">
  <nav-bar title="{{id ? '编辑闹钟' : '新建闹钟'}}" />
  <view class="pad">
    <view class="edit-hero"><view class="icon-box icon-sky"><image src="/assets/icons/lucide/alarm.png" mode="aspectFit" /></view><view><text class="h2">{{id ? '调整日常提醒' : '添加日常提醒'}}</text><text class="sub">时间、重复规则与启停一起保存</text></view></view>
    <view class="guard-loading" wx:if="{{loading}}" role="status">正在读取设备设置…</view>
    <view class="guard-notice" wx:if="{{!loading && canManage === false}}">当前为查看权限，设备配置需由主管理员修改。</view>
    <view class="guard-error" wx:if="{{error}}" role="alert">
      <text>{{error}}</text>
      <button wx:if="{{loadError}}" class="inline-action" bindtap="reload">重新加载</button>
    </view>
    <view class="guard-result" wx:if="{{result}}" role="status">{{result}}</view>
    <view class="guard-progress" wx:if="{{task && !result}}">
      <text>{{task.message || '正在等待处理结果'}}</text>
      <button wx:if="{{!busy && task.status !== 'success' && task.status !== 'failed'}}" class="inline-action" bindtap="checkTask">查询最终结果</button>
    </view>
    <view wx:if="{{!loading}}">
      <text class="form-label">提醒时间</text><picker mode="time" value="{{time}}" disabled="{{busy || !canManage || saved}}" bindchange="onTime"><view class="time-picker"><text>{{time}}</text><text class="caption">轻触选择时间</text></view></picker>
      <text class="form-label mt-16">提醒名称</text><input class="input mt-8" value="{{label}}" maxlength="20" disabled="{{busy || !canManage || saved}}" bindinput="onLabel" placeholder="例如：起床、出门、晚安" />
      <text class="form-label mt-16">重复方式</text><picker mode="selector" range="{{repeatOptions}}" value="{{repeatIndex}}" disabled="{{busy || !canManage || saved}}" bindchange="onRepeat"><view class="item between"><text>重复</text><text class="status">{{repeat}} ›</text></view></picker>
      <button class="item toggle-row between" disabled="{{busy || !canManage || saved}}" bindtap="toggle"><text>启用闹钟</text><text class="status">{{enabled ? '开' : '关'}}</text></button>
      <text class="caption mt-16">“仅一次”为下一次到达设定时间时提醒。设备离线时可保存，待上线同步后生效。{{id && !synced ? '当前设置待同步。' : ''}}</text>
    </view>
  </view>
  <view class="footer"><button class="btn btn-primary" loading="{{busy}}" disabled="{{busy || loading || (!canManage && !saved)}}" bindtap="save">{{saved ? '完成，返回闹钟' : '保存闹钟'}}</button><button class="btn btn-ghost danger mt-8" wx:if="{{id && !saved}}" disabled="{{busy || loading || !canManage}}" bindtap="del">删除闹钟</button></view>
</view>
