@import "./guard.wxss";
.sos-hero{display:flex;align-items:center;gap:20rpx;margin:18rpx 0 24rpx;padding:26rpx;border-radius:28rpx;background:#edf4f9;border:1rpx solid #dce7f0}.sos-hero .h2{font-size:31rpx}.sos-icon{width:68rpx;height:72rpx;border-radius:22rpx;background:#fff;display:flex;align-items:center;justify-content:center;flex:none}.sos-icon image{width:40rpx;height:40rpx}.contact-main{display:flex;align-items:center;gap:18rpx}.rank{width:56rpx;height:64rpx;border-radius:18rpx;background:#f5ecd5;color:#97753a;font-size:28rpx;font-weight:650;display:flex;align-items:center;justify-content:center;flex:none}.sos-actions{display:flex;align-items:center;justify-content:flex-end;gap:20rpx;border-top:1rpx solid #e6eef4;margin-top:22rpx;padding-top:10rpx}.order-button,.danger-inline{width:auto!important;min-height:76rpx;padding:16rpx 18rpx;font-size:24rpx;color:#26759f}.danger-inline{color:#b85349}.contact-main .caption{font-size:21rpx}
