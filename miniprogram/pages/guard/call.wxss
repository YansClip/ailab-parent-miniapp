@import "./guard.wxss";
.call-stage{min-height:calc(100vh - 150rpx);text-align:center;padding:30rpx 40rpx calc(240rpx + env(safe-area-inset-bottom));background:radial-gradient(circle at 50% 26%,#deedf7 0,#f7fafd 55%)}
.big{font-size:42rpx;font-weight:650;display:block}.actions{display:flex;justify-content:center;margin-top:42rpx}
.fab{width:126rpx!important;height:130rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;color:#21465f;font-size:21rpx;background:#e8f0f6;margin:0 10rpx;padding:0;line-height:1.3;flex-direction:column;border:2rpx solid #d5e3ec}
.fab image{width:38rpx;height:38rpx;margin-bottom:12rpx}.fab.on{border-color:#368dbb;background:#d9edf8;color:#156892}
.call-child{display:block;margin-top:10rpx;font-size:27rpx;font-weight:600;color:#567085}
.privacy-note{display:flex;align-items:center;justify-content:center;gap:12rpx;color:#687e8e;font-size:22rpx;line-height:1.6}.privacy-note image{width:30rpx;height:30rpx;flex:none}
.call-aura{position:relative;width:250rpx;height:250rpx;display:flex;align-items:center;justify-content:center;margin:38rpx auto 16rpx}
.pulse{position:absolute;top:8rpx;right:8rpx;bottom:8rpx;left:8rpx;border-radius:50%;border:3rpx solid rgba(50,128,176,.25);animation:pulse 1.8s ease-out infinite}.pulse.p2{animation-delay:.55s}
@keyframes pulse{0%{transform:scale(.72);opacity:.8}100%{transform:scale(1.25);opacity:0}}
.avatar-lg{width:190rpx;height:190rpx;border-radius:58rpx;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 18rpx 42rpx rgba(21,70,98,.12);border:1rpx solid #dce8f0}.avatar-lg image{width:176rpx;height:176rpx}
.duration{display:block;margin-top:24rpx;color:#207aab;font-size:48rpx;font-weight:600;letter-spacing:4rpx;font-variant-numeric:tabular-nums}.note{text-align:center;display:block;font-size:21rpx}
.media-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 22rpx;text-align:left;font-size:27rpx;font-weight:600;color:#284c65}.media-type{padding:8rpx 14rpx;background:#deedf5;border-radius:12rpx;font-size:21rpx;flex:none;margin-left:12rpx}
.video-preview{position:relative;height:580rpx;border-radius:32rpx;background:linear-gradient(150deg,#123751,#285771);overflow:hidden;border:1rpx solid #416a80;margin-bottom:24rpx;box-shadow:0 14rpx 36rpx rgba(18,55,81,.14)}
.remote-illustration{width:80%;height:75%;position:absolute;top:4%;left:10%}.video-caption{position:absolute;left:24rpx;bottom:24rpx;color:#e8f6ff;font-size:22rpx;background:rgba(5,32,53,.7);padding:10rpx 14rpx;border-radius:12rpx;max-width:52%;text-align:left}
.video-wait{padding:120rpx 26rpx 0;display:flex;align-items:center;flex-direction:column;gap:24rpx;color:#dbedf7;font-size:25rpx}.camera-outline{width:48rpx;height:34rpx;border:3rpx solid currentColor;border-radius:8rpx;position:relative;margin-right:15rpx}.camera-outline:after{content:"";position:absolute;right:-19rpx;top:5rpx;width:14rpx;height:18rpx;border:3rpx solid currentColor;border-radius:3rpx}.camera-outline.small{width:30rpx;height:22rpx;margin-bottom:16rpx}.camera-outline.small:after{right:-14rpx;top:2rpx;width:10rpx;height:12rpx}
.self-preview{position:absolute;right:18rpx;bottom:18rpx;width:160rpx;min-height:190rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;background:#d6e5ed;border-radius:20rpx;padding:16rpx;color:#24465c;font-size:19rpx;box-sizing:border-box}.self-avatar{width:74rpx;height:74rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:23rpx}.unsupported{padding:22rpx;background:#fff1db;color:#79542a;border-radius:18rpx;font-size:25rpx;margin-top:20rpx}.actions{gap:8rpx}.fab{flex:1;min-width:0;max-width:134rpx;margin:0 3rpx}
