<view class="page page-has-footer">
  <nav-bar title="{{pick ? '选择紧急联系人' : '通讯录'}}" action="{{canManage ? '新增' : ''}}" bind:action="add" />
  <view class="pad">
    <view class="section-intro"><view class="icon-box icon-sky"><image src="/assets/icons/lucide/contact.png" mode="aspectFit" /></view><view><text class="h2">{{pick ? '选择重要联系人' : '设备通讯录'}}</text><text class="sub">按孩子独立管理 · 演示数据</text></view></view>
    <view class="guard-loading" wx:if="{{loading}}" role="status">正在读取设备设置…</view>
    <view class="guard-notice" wx:if="{{!loading && canManage === false}}">当前为查看权限，设备配置需由主管理员修改。</view>
    <view class="guard-error" wx:if="{{error}}" role="alert">
      <text>{{error}}</text>
      <button wx:if="{{loadError}}" class="inline-action" bindtap="reload">重新加载</button>
    </view>
    <view class="guard-result" wx:if="{{result}}" role="status">{{result}}</view>
    <view class="guard-progress" wx:if="{{task && !result}}">
      <text>{{task.message || '正在等待处理结果'}}</text>
      <button wx:if="{{!busy && task.status !== 'success' && task.status !== 'failed'}}" class="inline-action" bindtap="checkTask">查询最终结果</button>
    </view>
    <view class="guard-notice" wx:if="{{pick}}">选择 1 至 3 人，按选择顺序加入呼叫名单。已选 {{count}} 人。仅“允许设备通话”的联系人可选。</view>
    <empty-state wx:if="{{!loading && !error && !list.length}}" title="还没有联系人" desc="新增家人或老师后，可为孩子设置联系对象。" action="{{canManage ? '新增联系人' : ''}}" bind:action="add" />
    <button class="item list-button {{pick && item.picked ? 'selected-contact' : ''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" disabled="{{busy}}" bindtap="edit" aria-label="{{pick ? '选择' : '查看'}}联系人{{item.name}}">
      <view class="between"><view class="contact-main"><view class="contact-avatar"><image src="/assets/icons/lucide/contact.png" mode="aspectFit" /></view><view><text class="h3">{{item.name}}</text><text class="sub">{{item.relation}} · {{item.phone}}</text><text class="caption">{{item.synced === false ? '已保存 · 待设备同步' : '设备已同步'}}</text></view></view><text class="status" wx:if="{{pick}}">{{item.picked ? '已选' : item.deviceCall ? '选择' : '不可选'}}</text><text class="status" wx:else>{{item.deviceCall ? '可通话' : '仅保存'}}</text></view>
    </button>
    <text class="caption mt-16">设备离线时可保存设置；以“设备已同步”作为生效依据。</text>
  </view>
  <view class="page-fixed-footer" wx:if="{{pick}}"><button class="btn btn-primary" loading="{{busy}}" disabled="{{busy || loading || !canManage}}" bindtap="confirmPick">保存紧急联系人（{{count}} / 3）</button></view>
</view>
