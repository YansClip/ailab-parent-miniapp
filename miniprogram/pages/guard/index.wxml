<view class="page page-tab guard" style="padding-top: {{statusBarHeight}}px;">
  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
    <view class="pad head">
      <view>
        <text class="h1">安心守护</text>
        <text class="sub">已连续守护 {{loc.child.days || 126}} 天</text>
      </view>
      <button class="pill device-pill {{loc.online ? 'pill-mint' : 'pill-coral'}}" hover-class="pressed" bindtap="openSwitcher" aria-label="切换孩子与设备">
        {{loc.child.shortName || '孩子'}} · {{loc.online ? '在线' : '离线'}} · {{loc.battery || '—'}}%
      </button>
    </view>

    <view class="pad" wx:if="{{loading}}" role="status" aria-label="正在加载守护位置">
      <view class="map-wrap skeleton"></view>
      <view class="tools-skeleton skeleton"></view>
    </view>

    <view class="pad" wx:elif="{{error}}">
      <view class="map-wrap empty-map">
        <empty-state title="守护数据暂时不可用" desc="{{error}}" action="重新加载" tone="coral" bind:action="reload" />
      </view>
    </view>

    <view class="pad" wx:else>
      <view class="map-wrap" wx:if="{{loc.status === 'valid' && loc.point}}">
        <image class="map-visual" src="/assets/illustrations/guardian-map-v2.jpg" mode="aspectFill" aria-label="当前位置周边地图" />
        <view class="location-marker" aria-label="{{loc.child.shortName}}的当前位置">
          <view class="location-pulse"></view>
          <view class="location-core"><image src="/assets/icons/lucide/online.png" mode="aspectFit" /></view>
        </view>
        <view class="loc-card">
          <text class="loc-title">{{loc.label}}</text>
          <text class="sub">定位精度约 {{loc.accuracy}} 米 · 更新于 {{relative}}</text>
          <text class="loc-hint">仅显示当前实时位置，不保存历史轨迹</text>
          <button class="refresh" loading="{{refreshing}}" disabled="{{refreshing}}" hover-class="pressed" bindtap="onRefresh">{{refreshing ? '刷新中…' : '刷新位置'}}</button>
        </view>
      </view>
      <view class="map-wrap empty-map" wx:else>
        <empty-state title="{{loc.label || '暂无有效位置'}}" desc="{{loc.hint || '位置失效后已清除坐标。'}}" action="刷新位置" busy="{{refreshing}}" tone="sky" bind:action="onRefresh" />
      </view>
    </view>

    <block wx:if="{{!loading}}">
    <view class="pad tool-head">
      <text class="section-title">设备工具</text>
      <text class="sub">轻触即可操作</text>
    </view>
    <view class="pad tools">
      <button class="tool" hover-class="pressed" bindtap="go" data-url="/pages/guard/call" aria-label="打开语音通话">
        <view class="ticon t-yellow"><image src="/assets/icons/lucide/phone.png" mode="aspectFit" /></view>
        <text>语音通话</text>
      </button>
      <button class="tool" hover-class="pressed" bindtap="go" data-url="/pages/guard/contacts" aria-label="打开通讯录">
        <view class="ticon t-pink"><image src="/assets/icons/lucide/contact.png" mode="aspectFit" /></view>
        <text>通讯录</text>
      </button>
      <button class="tool" hover-class="pressed" bindtap="go" data-url="/pages/guard/find" aria-label="打开查找设备">
        <view class="ticon t-green"><image src="/assets/icons/lucide/search.png" mode="aspectFit" /></view>
        <text>查找设备</text>
      </button>
      <button class="tool" hover-class="pressed" bindtap="go" data-url="/pages/guard/alarm" aria-label="打开闹钟">
        <view class="ticon t-cyan"><image src="/assets/icons/lucide/alarm.png" mode="aspectFit" /></view>
        <text>闹钟</text>
      </button>
      <button class="tool" hover-class="pressed" bindtap="go" data-url="/pages/guard/sos" aria-label="打开紧急联系人">
        <view class="ticon t-red"><image src="/assets/icons/lucide/sos.png" mode="aspectFit" /></view>
        <text>紧急联系人</text>
      </button>
    </view>

    <view class="pad mt-16 pb">
      <view class="card safety">
        <view class="between">
          <text class="h3">守护状态</text>
          <view class="pill {{loc.status === 'valid' ? 'pill-mint' : 'pill-butter'}}">{{loc.status === 'valid' ? '全部正常' : loc.label}}</view>
        </view>
        <view class="s-row">
          <view class="s-col">
            <text class="s-num">{{relative || '—'}}</text>
            <text class="sub">位置更新</text>
          </view>
          <view class="s-col">
            <text class="s-num">{{loc.sosCount || 0}} 人</text>
            <text class="sub">紧急联系人</text>
          </view>
          <view class="s-col">
            <text class="s-num">{{loc.nextAlarm || '—'}}</text>
            <text class="sub">明天早晨</text>
          </view>
        </view>
      </view>
    </view>
    </block>
  </scroll-view>

  <child-switcher show="{{showSwitcher}}" children="{{children}}" current-id="{{loc.child.id}}" bind:close="closeSwitcher" bind:change="onChildChange" />
</view>
