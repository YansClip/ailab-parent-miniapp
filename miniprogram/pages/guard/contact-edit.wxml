<view class="page">
  <nav-bar title="{{id ? '编辑联系人' : '新增联系人'}}" />
  <view class="pad">
    <view class="edit-hero"><view class="icon-box icon-lavender"><image src="/assets/icons/lucide/contact.png" mode="aspectFit" /></view><view><text class="h2">{{id ? '编辑联系人资料' : '添加设备联系人'}}</text><text class="sub">仅同步必要的姓名、关系和联系方式</text></view></view>
    <text class="form-label">姓名</text>
    <input class="input" placeholder="姓名" value="{{name}}" bindinput="setName" />
    <text class="form-label mt-16">与孩子的关系</text>
    <input class="input mt-12" placeholder="关系" value="{{relation}}" bindinput="setRel" />
    <text class="form-label mt-16">手机号</text>
    <input class="input mt-12" placeholder="手机号" value="{{phone}}" bindinput="setPhone" />
    <button class="item toggle-row mt-16 between" bindtap="toggle" aria-label="{{deviceCall ? '关闭设备通话权限' : '开启设备通话权限'}}">
      <text>允许设备通话</text>
      <text class="status">{{deviceCall ? '开' : '关'}}</text>
    </button>
    <text class="sub mt-16">保存后会同步到孩子的 Mini 设备，设备离线时将在恢复连接后继续同步。</text>
    <text class="status mt-8" wx:if="{{task}}">{{task.message}}</text>
  </view>
  <view class="footer">
    <button class="btn btn-primary" loading="{{busy}}" disabled="{{busy}}" hover-class="pressed" bindtap="save">保存并同步到设备</button>
    <button class="btn btn-ghost mt-12" wx:if="{{id}}" bindtap="remove">删除</button>
  </view>
</view>
