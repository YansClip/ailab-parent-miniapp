<view class="page page-has-footer">
  <nav-bar title="查找设备" />
  <view class="pad">
    <text class="demo-label">演示模式 · 不触发真实设备响铃</text>
    <view class="find-visual {{stage}}"><view class="find-rings"></view><image src="/assets/illustrations/mini-device-v2.png" mode="aspectFit" /></view>
    <text class="caption">{{child}}的 Mini</text>
    <text class="h1 mt-8">{{loading ? '正在查询响铃状态' : title}}</text>
    <text class="sub mt-12">{{desc}}</text>
    <view class="guard-error" wx:if="{{error}}"><text>{{error}}</text><button class="inline-action" bindtap="reload">重新查询状态</button></view>
    <view class="ring-counter" wx:if="{{stage === 'ringing'}}">
      <text class="counter">{{left}}<text class="counter-unit">秒</text></text>
      <text class="sub">预计 {{endTime}} 自动停止</text>
      <text class="caption">倒计时按会话结束时间计算，返回页面会恢复。</text>
    </view>
    <view class="guard-notice mt-16">响铃成功只代表设备响应，不代表已经找到设备。手动停止后会显示明确的停止结果。</view>
  </view>
  <view class="footer">
    <button class="btn btn-secondary" wx:if="{{stage === 'ringing'}}" loading="{{busy}}" disabled="{{busy || loading}}" bindtap="stop">{{busy ? '正在确认停止结果' : '手动停止响铃'}}</button>
    <button class="btn btn-primary" wx:else loading="{{busy}}" disabled="{{busy || loading}}" bindtap="start">{{stage === 'ready' ? '确认响铃查找' : '再次响铃查找'}}</button>
  </view>
</view>
