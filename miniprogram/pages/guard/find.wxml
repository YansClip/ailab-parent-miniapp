<view class="page">
  <nav-bar title="查找设备" />
  <view class="pad">
    <view class="find-visual {{stage}}"><view class="find-rings"></view><image src="/assets/illustrations/mini-device-v2.png" mode="aspectFit" /></view>
    <text class="h1">{{title}}</text>
    <text class="sub mt-12">{{desc}}</text>
    <view class="card card-p mt-24" wx:if="{{stage==='ringing'}}">
      <text class="h3">设备响铃中</text>
      <text class="sub">剩余 {{left}} 秒，最长 60 秒。离开页面后任务仍由后台维护。</text>
    </view>
    <view class="card card-p mt-24" wx:if="{{stage==='stopping'}}" role="status">
      <text class="h3">{{task.message || '停止请求提交中'}}</text>
      <text class="sub">请不要重复操作，结果以设备最终确认状态为准。</text>
    </view>
    <view class="task-state mt-24 {{stage==='found' ? 'success' : stage==='failed' || stage==='offline' ? 'failed' : ''}}"><view class="task-state-dot"></view><view class="task-state-copy"><text class="h3">{{stage==='start' ? '准备就绪' : title}}</text><text class="sub">设备收到请求后会持续响铃，手动停止或最长 60 秒自动结束。</text></view></view>
  </view>
  <view class="footer">
    <button class="btn btn-primary" wx:if="{{stage==='start'}}" hover-class="pressed" bindtap="start">确认响铃查找</button>
    <button class="btn btn-secondary" wx:if="{{stage==='ringing'}}" hover-class="pressed" bindtap="stop">手动停止</button>
    <button class="btn btn-disabled" wx:if="{{stage==='stopping'}}" disabled>正在确认停止结果…</button>
    <button class="btn btn-primary" wx:if="{{stage==='found' || stage==='timeout' || stage==='offline' || stage==='failed'}}" hover-class="pressed" bindtap="reset">再次查找</button>
  </view>
</view>
