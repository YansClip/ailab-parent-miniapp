<view class="page">
  <nav-bar title="查找设备" />
  <view class="pad">
    <text class="h1">{{title}}</text>
    <text class="sub mt-12">{{desc}}</text>
    <view class="card card-p mt-24" wx:if="{{stage==='ringing'}}">
      <text class="h3">设备响铃中</text>
      <text class="sub">剩余 {{left}} 秒，最长 60 秒。离开页面后任务仍由后台维护。</text>
    </view>
  </view>
  <view class="footer">
    <button class="btn btn-primary" wx:if="{{stage==='start'}}" hover-class="pressed" bindtap="start">确认响铃查找</button>
    <button class="btn btn-secondary" wx:if="{{stage==='ringing'}}" hover-class="pressed" bindtap="stop">手动停止</button>
    <button class="btn btn-primary" wx:if="{{stage==='found' || stage==='timeout' || stage==='offline' || stage==='failed'}}" hover-class="pressed" bindtap="reset">再次查找</button>
  </view>
</view>
