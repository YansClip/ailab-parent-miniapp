@import "./guard.wxss";
.guard{height:100vh;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box}.scroll{flex:1;height:0}
.head{display:flex;flex-direction:column;align-items:flex-start;padding-top:14rpx;margin-bottom:22rpx}.head .h1{font-size:48rpx;letter-spacing:1rpx}.head .sub{margin-top:8rpx}.eyebrow{display:block;color:#8399a9;letter-spacing:4rpx;font-size:19rpx;font-weight:600;margin-bottom:14rpx}
.device-pill{margin-top:20rpx;gap:14rpx;border:1rpx solid #d6e5ef;min-height:60rpx}.switch-hint{font-size:20rpx;opacity:.65;border-left:1rpx solid #bccfdc;padding-left:14rpx}
.map-panel{overflow:hidden;border-radius:32rpx;border:1rpx solid #dbe7f1;background:white;box-shadow:0 10rpx 30rpx rgba(17,52,78,.05)}
.map-wrap{height:380rpx;overflow:hidden;position:relative;background:#eef4f8;border-radius:30rpx}.map-panel .map-wrap{border-radius:0}
.live-map{width:100%;height:100%}.map-fallback{height:100%;padding:50rpx 36rpx;display:flex;flex-direction:column;justify-content:center;text-align:center}.map-fallback .sub{margin-top:16rpx}
.empty-map{display:flex;align-items:center;justify-content:center}.loc-card{padding:26rpx 28rpx;display:flex;flex-direction:column;background:#fff}.loc-title{font-size:28rpx;font-weight:650;max-width:75%}.location-badge{padding:5rpx 12rpx;border-radius:8rpx;background:#f8f1dc;color:#8b6d34;font-size:19rpx;flex:none}
.loc-card .sub{margin-top:10rpx}.loc-card .caption{margin-top:6rpx}.location-policy{margin-top:16rpx;font-size:21rpx}.refresh{width:auto!important;min-height:72rpx;color:#1b75a8;align-self:flex-end;font-size:24rpx;font-weight:650;margin-top:8rpx;padding:12rpx 0}
.tool-head{display:flex;justify-content:space-between;align-items:center;margin-top:34rpx}.tools{display:flex;justify-content:space-between;margin-top:22rpx}.tool{width:120rpx!important;margin:0;padding:0;background:transparent;line-height:1.3;display:flex;flex-direction:column;align-items:center;font-size:23rpx;font-weight:500}.tool text{margin-top:14rpx;white-space:nowrap}
.ticon{width:88rpx;height:88rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;background:#e0f0fb;border:1rpx solid #cfe4f2}.ticon image{width:40rpx;height:40rpx}.t-gold{background:#f9f0d6;border-color:#eedfaf}.t-navy{background:#d6e3f0;border-color:#bfd1e3}
.safety{padding:28rpx;background:#fff}.s-row{display:flex;margin-top:24rpx}.s-col{flex:1;display:flex;flex-direction:column;border-right:1rpx solid #e8eef4;padding-left:20rpx}.s-col:first-child{padding-left:0}.s-col:last-child{border:0}.s-col .caption{margin-top:8rpx}.s-num{font-size:26rpx;font-weight:650;color:#21465f}.pb{padding-bottom:36rpx}
