@import "./guard.wxss";
.guard{height:100vh;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box;padding-bottom:0;background:linear-gradient(180deg,#eaf5fa,#f5f8fa 650rpx)}.scroll{flex:1;height:0}.head{display:flex;flex-direction:column;align-items:flex-start;padding-top:calc(44px + 24rpx);margin-bottom:18rpx}.head .h1{font-size:42rpx;margin-top:8rpx}.eyebrow{display:block;color:#4b899b;letter-spacing:2rpx;font-size:20rpx}.device-pill{margin-top:20rpx;gap:14rpx;border:1rpx solid #d2e5ed;min-height:66rpx;background:#fff;font-size:24rpx;color:#286c86}.switch-hint{font-size:21rpx;color:#718e9c;border-left:1rpx solid #d6e2e8;padding-left:14rpx}.demo-label{font-size:20rpx;border:0;padding:8rpx 14rpx;color:#648799;background:#e2eff5}
.location-heading{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;gap:12rpx}.location-heading .h3{font-size:29rpx}.location-heading .caption{font-size:21rpx}.map-panel{overflow:hidden;border-radius:32rpx;border:1rpx solid #dbe8ee;background:#fff;box-shadow:0 10rpx 26rpx rgba(17,52,78,.05)}.map-wrap{height:360rpx;overflow:hidden;position:relative;background:#eaf2f6;border-radius:30rpx}.map-panel .map-wrap{border-radius:0}.live-map{width:100%;height:100%}.map-fallback{height:100%;padding:40rpx 28rpx;display:flex;flex-direction:column;justify-content:center;text-align:center}.map-fallback .sub{margin-top:14rpx}.empty-map{display:flex;align-items:center;justify-content:center;border:1rpx solid #dbe8ee;background:rgba(255,255,255,.75)}.loc-card{padding:26rpx;display:flex;flex-direction:column;background:#fff}.loc-title{font-size:30rpx;font-weight:650;max-width:75%;line-height:1.5}.location-badge{padding:6rpx 12rpx;border-radius:12rpx;background:#f9efd6;color:#8c712f;font-size:20rpx;flex:none}.loc-card .sub{margin-top:10rpx;font-size:24rpx}.loc-card .caption{margin-top:8rpx;font-size:21rpx}.location-policy{display:block;margin-top:16rpx;font-size:21rpx;color:#6e8a99;line-height:1.6}.refresh{width:100%!important;min-height:88rpx;color:#1b7492;align-self:stretch;font-size:25rpx;font-weight:650;margin-top:20rpx;padding:18rpx;background:#eaf5f8;border-radius:22rpx}.refresh-state{padding:22rpx;color:#205a7c;background:#eaf4fa;border-radius:20rpx;margin-top:12rpx;font-size:24rpx}
.tool-head{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:36rpx}.tool-head .section-title{font-size:31rpx;font-weight:700;color:#173d53}.tool-head .caption{font-size:20rpx}.call-tools{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:20rpx}.call-entry{width:100%!important;min-width:0;min-height:278rpx;border-radius:30rpx;display:flex;flex-direction:column;align-items:flex-start;padding:26rpx;text-align:left;line-height:1.5;position:relative;overflow:hidden}.voice-entry{background:#176581;color:#fff;box-shadow:0 10rpx 24rpx rgba(23,101,129,.13)}.video-entry{background:#dceef4;color:#255d73;border:1rpx solid #c8e2eb}.call-icon{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:rgba(255,255,255,.18);margin-bottom:16rpx}.call-icon image{width:32rpx;height:32rpx;filter:brightness(0) invert(1)}.video-entry .call-icon{background:rgba(255,255,255,.55)}.call-title{font-size:32rpx;font-weight:700;display:block}.call-desc{font-size:22rpx;display:block;margin-top:6rpx;opacity:.78}.call-link{font-size:23rpx;margin-top:20rpx;display:block;font-weight:600}.video-symbol{width:30rpx;height:24rpx;border:3rpx solid #236489;border-radius:6rpx;position:relative;margin-right:10rpx}.video-lens{position:absolute;right:-15rpx;top:3rpx;width:11rpx;height:14rpx;border:3rpx solid #236489;border-radius:3rpx}
.empty-map{height:auto;min-height:360rpx;overflow:visible}.secondary-heading .section-title{font-size:29rpx}.tools{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}.tool{width:100%!important;min-height:132rpx;min-width:0;margin:0;padding:22rpx 18rpx;display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #dfeaf0;border-radius:26rpx;line-height:1.5;text-align:left}.tool-copy{display:flex;flex-direction:column;min-width:0}.tool-copy>text:first-child{font-size:26rpx;font-weight:650;color:#254c62}.tool-desc{font-size:21rpx;color:#8399a6;margin-top:5rpx}.ticon{width:62rpx;height:62rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;background:#e5f1f6;flex:none}.ticon image{width:32rpx;height:32rpx}.t-gold{background:#fff1d3}.t-mint{background:#e8f3ed}.t-navy{background:#e2eaf4}
.safety{padding:28rpx;background:#fff;border-radius:30rpx}.s-row{display:flex;margin-top:24rpx;gap:12rpx}.s-col{flex:1;min-width:0;display:flex;flex-direction:column;border-right:1rpx solid #e8eef4;padding-left:12rpx}.s-col:first-child{padding-left:0}.s-col:last-child{border:0}.s-col .caption{margin-top:8rpx;font-size:21rpx}.s-num{font-size:26rpx;font-weight:650;color:#21465f}.pb{padding-bottom:0}.bottom-space{height:calc(160rpx + env(safe-area-inset-bottom))}
.ticon image{filter:brightness(0);opacity:.65}
@media(max-width:340px){.head .h1{font-size:37rpx}.tool-head .section-title{font-size:28rpx}.tool-head .caption{font-size:19rpx}.call-entry{padding:22rpx}.call-desc{font-size:21rpx}.tools{gap:12rpx}.tool{padding:20rpx 14rpx;gap:10rpx}.tool-copy>text:first-child{font-size:24rpx}.tool-desc{font-size:19rpx}.ticon{width:54rpx;height:54rpx}.loc-title{font-size:28rpx}}
