<view class="page">
  <nav-bar title="闹钟" action="新建" bind:action="add" />
  <view class="pad">
    <view class="alarm-hero"><view class="icon-box icon-mint"><image src="/assets/icons/lucide/alarm.png" mode="aspectFit" /></view><view><text class="h2">日常提醒</text><text class="sub">设置会同步到当前孩子的 Mini 设备</text></view></view>
    <empty-state wx:if="{{!list.length}}" title="还没有闹钟" desc="可以添加起床、出门或晚安提醒。" action="新建闹钟" bind:action="add" />
    <button class="item list-button" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" hover-class="pressed" bindtap="edit" aria-label="编辑闹钟{{item.label}}，{{item.time}}">
      <view class="between">
        <view class="alarm-copy"><text class="alarm-label">{{item.label}}</text>
          <text class="h1">{{item.time}}</text>
          <text class="sub">{{item.repeat}}</text>
        </view>
        <view class="alarm-status {{item.enabled ? 'on' : ''}}"><view></view><text>{{item.enabled ? '已开启' : '已关闭'}}</text></view>
      </view>
    </button>
  </view>
</view>
