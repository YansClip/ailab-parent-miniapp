<view class="page">
  <nav-bar title="闹钟" action="{{canManage ? '新建' : ''}}" bind:action="add" />
  <view class="pad">
    <view class="alarm-hero"><view class="icon-box icon-sky"><image src="/assets/icons/lucide/alarm.png" mode="aspectFit" /></view><view><text class="h2">有节奏地长大</text><text class="sub">管理当前孩子的日常提醒 · 演示数据</text></view></view>
    <view class="guard-loading" wx:if="{{loading}}" role="status">正在读取设备设置…</view>
    <view class="guard-notice" wx:if="{{!loading && canManage === false}}">当前为查看权限，设备配置需由主管理员修改。</view>
    <view class="guard-error" wx:if="{{error}}" role="alert">
      <text>{{error}}</text>
      <button wx:if="{{loadError}}" class="inline-action" bindtap="reload">重新加载</button>
    </view>
    <view class="guard-result" wx:if="{{result}}" role="status">{{result}}</view>
    <view class="guard-progress" wx:if="{{task && !result}}">
      <text>{{task.message || '正在等待处理结果'}}</text>
      <button wx:if="{{!busy && task.status !== 'success' && task.status !== 'failed'}}" class="inline-action" bindtap="checkTask">查询最终结果</button>
    </view>
    <empty-state wx:if="{{!loading && !error && !list.length}}" title="还没有闹钟" desc="可以添加起床、出门或晚安提醒。" action="{{canManage ? '新建闹钟' : ''}}" bind:action="add" />
    <view class="item alarm-item" wx:for="{{list}}" wx:key="id">
      <view class="between"><button class="alarm-edit-button" data-id="{{item.id}}" disabled="{{busy}}" bindtap="edit" aria-label="编辑{{item.label}}闹钟"><text class="alarm-label">{{item.label}}</text><text class="h1">{{item.time}}</text><text class="sub">{{item.repeat}}</text></button><button class="alarm-toggle {{item.enabled ? 'on' : ''}}" data-id="{{item.id}}" disabled="{{busy || !canManage}}" bindtap="toggle" aria-label="{{item.enabled ? '关闭' : '开启'}}{{item.label}}闹钟"><view class="toggle-track"><view></view></view><text>{{item.enabled ? '已开启' : '已关闭'}}</text></button></view>
      <text class="caption">{{item.synced === false ? '已保存 · 待设备同步' : '设备已同步'}}</text>
    </view>
    <text class="caption mt-16">轻触时间编辑；右侧开关保存启停设置。设备离线时以待同步显示。</text>
  </view>
</view>
