@import "./guard.wxss";
.alarm-label{display:block;font-size:24rpx;color:#49738d;font-weight:600;margin-bottom:8rpx}.alarm-edit-button{text-align:left;padding:0 36rpx 12rpx 0;flex:1}.alarm-toggle{width:116rpx!important;min-height:110rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10rpx;font-size:22rpx;color:#7c92a1}.toggle-track{height:50rpx;width:90rpx;background:#d3dfe7;border-radius:30rpx;padding:6rpx}.toggle-track view{height:38rpx;width:38rpx;border-radius:50%;background:#fff;box-shadow:0 3rpx 8rpx rgba(25,60,83,.12)}.alarm-toggle.on{color:#216e98}.alarm-toggle.on .toggle-track{background:#358ebc}.alarm-toggle.on .toggle-track view{margin-left:40rpx}.alarm-item>.caption{padding-top:16rpx;border-top:1rpx solid #e7eff5;font-size:21rpx}
