@import "./guard.wxss";
.find-visual{height:290rpx;margin:24rpx 0;border-radius:32rpx;background:linear-gradient(145deg,#e0eff9,#f5f9fc);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.find-visual image{width:230rpx;height:250rpx;position:relative;z-index:2}.find-rings{position:absolute;width:180rpx;height:180rpx;border-radius:50%;border:3rpx solid rgba(39,125,175,.22);box-shadow:0 0 0 32rpx rgba(39,125,175,.08),0 0 0 65rpx rgba(39,125,175,.04)}.find-visual.ringing .find-rings{animation:ring 1.4s ease-in-out infinite}@keyframes ring{50%{transform:scale(1.12);opacity:.55}}
.ring-counter{margin-top:28rpx;padding:24rpx;background:#fff;border:1rpx solid #dce8f0;border-radius:28rpx}.counter{display:block;font-size:72rpx;line-height:1.2;letter-spacing:2rpx;color:#176f9e;font-weight:650;font-variant-numeric:tabular-nums}.counter-unit{font-size:25rpx;color:#708799;margin-left:10rpx}
