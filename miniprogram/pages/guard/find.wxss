@import "../../styles/detail.wxss";
.find-visual{height:330rpx;margin:12rpx 0 28rpx;border-radius:42rpx;background:linear-gradient(145deg,#eaf6ff,#f1edff);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}.find-visual image{width:250rpx;height:270rpx;position:relative;z-index:2}.find-rings{position:absolute;width:190rpx;height:190rpx;border-radius:50%;border:4rpx solid rgba(64,179,82,.2);box-shadow:0 0 0 36rpx rgba(64,179,82,.08),0 0 0 72rpx rgba(64,179,82,.04)}.find-visual.ringing .find-rings{animation:ring 1.4s ease-in-out infinite}@keyframes ring{50%{transform:scale(1.12);opacity:.55}}
