<public-preview wx:if="{{guest}}" section="home" signed-in="{{signedIn}}" status-bar-height="{{statusBarHeight}}" />
<view wx:else class="home">
  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <view style="height: {{statusBarHeight + 44}}px"></view>
    <view class="pad">
      <view class="head"><view><text class="caption eyebrow">一起看见，每一次发现</text><text class="h1">{{parent.greeting || '你好'}}，{{parent.name || '家长'}}</text></view><button class="switch-button" bindtap="openSwitcher" aria-label="切换孩子">{{home.child.shortName || '选择孩子'}}<text>⌄</text></button></view>
      <view wx:if="{{loading}}" class="loading"><view class="skeleton sk-hero"></view><view class="skeleton sk-card"></view></view>
      <view wx:elif="{{error}}" class="card state-wrap"><text class="h2">首页暂时无法加载</text><text class="sub">{{error}}</text><button class="btn btn-primary mt-24" bindtap="reload">重新加载</button></view>
      <block wx:else>
        <view class="hero">
          <image class="hero-img" src="{{home.hero.image}}" mode="aspectFill" /><view class="hero-mask"></view>
          <view class="hero-top"><text class="hero-label">{{home.child.age}} 岁 · 探索中的小世界</text><view class="hero-status"><view class="status-dot {{home.summary.deviceOnline ? 'online' : ''}}"></view><text>{{home.summary.deviceOnline ? '设备在线' : '设备离线 / 未绑定'}}</text></view></view>
          <view class="hero-copy"><text class="hero-title">好奇心，有了新回声</text><text class="hero-sub">{{home.hero.subtitle}}</text></view>
          <button class="hero-device" data-url="/pages/my/device" bindtap="goUrl">{{home.child.deviceName || '设备中心'}}<text> {{home.child.battery === undefined ? '查看设备' : home.child.battery + '%'}} ›</text></button>
          <text class="hero-demo">演示数据</text>
        </view>
        <view class="summary">
          <button class="metric" bindtap="goFeed"><text class="metric-num">{{home.summary.dynamics || 0}}</text><text class="caption">探索记录 ›</text></button>
          <button class="metric" data-url="/pages/growth/index" bindtap="goUrl"><text class="metric-num">{{home.summary.completed === undefined ? '—' : home.summary.completed}}</text><text class="caption">内容已完成 ›</text></button>
          <button class="metric" bindtap="showTodos"><text class="metric-num gold">{{home.todos.length}}</text><text class="caption">需要留意 ↓</text></button>
        </view>
        <view class="section-block todos" id="home-todos">
          <button class="todo" wx:for="{{home.todos}}" wx:key="id" data-url="{{item.url}}" bindtap="goUrl"><view class="todo-icon"><image src="/assets/icons/lucide/notice.png" mode="aspectFit" /></view><view class="todo-copy"><text class="h3">{{item.title}}</text><text class="sub">{{item.desc}}</text></view><text class="arrow">›</text></button>
          <view wx:if="{{!home.todos.length}}" class="all-clear"><image src="/assets/icons/lucide/check.png" mode="aspectFit" /><text>一切已安排好，安心陪伴</text></view>
        </view>
        <view class="curiosity-section">
          <view class="section-lead"><view><text class="eyebrow">CURIOSITY NOTES</text><text class="section-title">好奇心推送卡片</text></view><button class="inline-action link" bindtap="goFeed">全部记录 ›</button></view>
          <text class="section-description">根据{{home.child.shortName || '孩子'}}的使用记录不定期更新，留住值得聊聊的瞬间。</text>
          <view wx:if="{{!groups.length}}" class="card state-wrap"><image class="empty-art" src="/assets/illustrations/empty-companion-v2.png" mode="aspectFit" /><text class="h2">下一次好奇，从这里开始</text><text class="sub">有新的提问、发现或成果时，卡片会出现在这里。</text><button class="btn btn-primary mt-24" data-url="/pages/my/device" bindtap="goUrl">查看设备与绑定</button></view>
          <view class="curiosity-group" wx:for="{{groups}}" wx:key="date" wx:for-item="group">
            <view class="date-heading"><view class="date-dot"></view><text>{{group.date}}</text><view class="date-line"></view></view>
            <button class="curiosity-card kind-{{item.kind}}" wx:for="{{group.items}}" wx:key="id" data-url="{{item.url}}" bindtap="goUrl" hover-class="pressed" aria-label="{{item.label}}：{{item.title}}，{{item.action}}">
              <view class="curiosity-cover"><image class="curiosity-image" src="{{item.image}}" mode="aspectFill" /><view class="cover-shade"></view><view class="card-category"><image src="{{item.icon}}" mode="aspectFit" /><text>{{item.label}}</text></view><text class="image-note">{{item.imageLabel}}</text><text wx:if="{{item.kind === 'question'}}" class="cover-question">一个好问题，<text>打开一个新世界。</text></text></view>
              <view class="curiosity-copy"><text class="card-title">{{item.title}}</text><text class="card-description">{{item.description}}</text><view class="card-bottom"><view class="card-child"><view class="child-dot">{{home.child.avatarText || '探'}}</view><text>{{home.child.shortName || '孩子'}}的探索记录</text></view><text class="card-link">{{item.action}} ›</text></view></view>
            </button>
          </view>
          <button wx:if="{{remainingCards > 0}}" class="more-cards" bindtap="expandCards">再看看 {{remainingCards}} 条发现 <text>↓</text></button>
        </view>
        <view class="suggest" wx:if="{{home.suggestion}}"><image src="/assets/icons/lucide/message.png" mode="aspectFit" /><view><text class="caption">今天，可以这样聊聊</text><text class="h3">{{home.suggestion.text}}</text></view></view>
        <button class="guide" data-url="/pages/my/guide" bindtap="goUrl"><view class="guide-icon"><image src="/assets/icons/lucide/guide.png" mode="aspectFit" /></view><view><text class="h3">让陪伴更轻松</text><text class="sub">玩机指南 · 设备连接与使用</text></view><text class="arrow">›</text></button>
      </block><view class="bottom-space"></view>
    </view>
  </scroll-view>
  <child-switcher show="{{showSwitcher}}" children="{{children}}" session="{{session}}" current-id="{{home.child.id || ''}}" bind:close="closeSwitcher" bind:change="onChildChange" />
</view>
