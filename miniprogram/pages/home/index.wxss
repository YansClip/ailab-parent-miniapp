.home{height:100vh;display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(180deg,#eaf5fa 0,#f5f8fa 700rpx);color:var(--navy)}
.scroll{flex:1;min-height:0}.head{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0 28rpx;gap:16rpx}.head .h1{font-size:42rpx;margin-top:8rpx}.eyebrow{display:block;font-size:20rpx;font-weight:600;letter-spacing:2rpx;color:#4b899b}
.switch-button{flex:none;width:auto!important;min-height:88rpx;padding:16rpx 22rpx;border:1rpx solid #d3e6ee;border-radius:28rpx;background:rgba(255,255,255,.8);color:#175d7c;font-size:25rpx;line-height:1.4;display:flex;align-items:center;gap:14rpx}.switch-button text{color:#7394a5}
.hero{height:370rpx;border-radius:36rpx;overflow:hidden;position:relative;background:#145377;box-shadow:0 16rpx 34rpx rgba(18,58,99,.13)}.hero-img,.hero-mask{position:absolute;inset:0;width:100%;height:100%}.hero-mask{background:linear-gradient(180deg,rgba(8,37,64,.15),rgba(8,37,64,.66)),linear-gradient(90deg,rgba(8,37,64,.42),transparent)}
.hero-top{position:absolute;top:26rpx;left:28rpx;right:28rpx;display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#fff}.hero-label{font-size:22rpx;opacity:.9}.hero-status{display:flex;align-items:center;gap:8rpx;padding:8rpx 12rpx;border-radius:14rpx;background:rgba(255,255,255,.14);font-size:19rpx}.status-dot{width:10rpx;height:10rpx;border-radius:50%;background:#ffc965}.status-dot.online{background:#8ce8be}
.hero-copy{position:absolute;left:30rpx;bottom:116rpx;right:24rpx;color:#fff}.hero-title{display:block;font-size:42rpx;font-weight:750;letter-spacing:1rpx;line-height:1.3}.hero-sub{display:block;margin-top:10rpx;font-size:24rpx;opacity:.87}.hero-device{position:absolute;left:28rpx;bottom:26rpx;min-height:68rpx;width:auto!important;padding:14rpx 20rpx;border:1rpx solid rgba(255,255,255,.34);border-radius:22rpx;background:rgba(255,255,255,.14);font-size:23rpx;line-height:1.4;color:white}.hero-device text{opacity:.82;margin-left:12rpx}.hero-demo{position:absolute;right:26rpx;bottom:43rpx;color:rgba(255,255,255,.76);font-size:19rpx}
.summary{display:flex;margin-top:22rpx;padding:20rpx 6rpx;border-radius:30rpx;background:white;border:1rpx solid #e4edf1;box-shadow:0 8rpx 24rpx rgba(18,58,99,.04)}.metric{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;padding:4rpx;border-right:1rpx solid #e6eff3;line-height:1.4}.metric:last-child{border:0}.metric-num{font-size:44rpx;font-weight:750;color:#196f8d}.metric-num.gold{color:#b8832c}.metric .caption{font-size:22rpx;margin-top:5rpx;color:#637c8b}
.todos{margin-top:18rpx}.todo{display:flex;align-items:center;gap:16rpx;width:100%!important;padding:22rpx;border:1rpx solid #efdfb6;border-radius:26rpx;background:#fff8e8;text-align:left}.todo-icon{width:56rpx;height:56rpx;border-radius:18rpx;background:#ffedba;display:flex;align-items:center;justify-content:center;flex:none}.todo-icon image{width:30rpx;height:30rpx}.todo-copy{flex:1;min-width:0}.todo .h3{font-size:27rpx;color:#715121}.todo .sub{font-size:22rpx;color:#8d774e;margin-top:4rpx}.arrow{font-size:36rpx;color:#7999a9;flex:none}.all-clear{display:flex;align-items:center;gap:12rpx;padding:20rpx;color:#4b7e73;font-size:23rpx}.all-clear image{width:28rpx;height:28rpx}
.curiosity-section{margin-top:48rpx}.section-lead{align-items:center;margin-bottom:10rpx;gap:8rpx}.section-lead .eyebrow{font-size:18rpx;letter-spacing:3rpx;margin-bottom:8rpx}.section-title{font-size:35rpx!important;font-weight:700;color:#173d53}.inline-action{font-size:22rpx;color:#287d98;flex:none;min-height:88rpx}.section-description{display:block;font-size:23rpx;color:#6c8492;line-height:1.7;margin-bottom:24rpx}
.date-heading{display:flex;align-items:center;gap:12rpx;margin:28rpx 0 16rpx;color:#638293;font-size:22rpx;font-weight:600}.date-dot{width:12rpx;height:12rpx;border-radius:50%;background:#67b4c1}.date-line{height:1rpx;background:#dbe7ec;flex:1;margin-left:8rpx}.curiosity-card{width:100%!important;margin:0 0 20rpx;overflow:hidden;border:1rpx solid #e0eaef;border-radius:32rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(23,61,83,.06);text-align:left;line-height:1.5}.curiosity-cover{position:relative;height:340rpx;overflow:hidden;background:#dcecf4}.curiosity-image,.cover-shade{position:absolute;inset:0;width:100%;height:100%}.cover-shade{background:linear-gradient(180deg,rgba(10,40,62,.18),transparent 45%,rgba(10,40,62,.28))}.card-category{position:absolute;left:22rpx;top:22rpx;display:flex;align-items:center;gap:8rpx;padding:10rpx 14rpx;border-radius:16rpx;color:#21465d;background:rgba(255,255,255,.94);font-size:21rpx;font-weight:600}.card-category image{width:26rpx;height:26rpx}.image-note{position:absolute;right:20rpx;bottom:16rpx;font-size:18rpx;color:#fff;background:rgba(18,46,63,.3);padding:5rpx 10rpx;border-radius:10rpx}.cover-question{position:absolute;left:26rpx;bottom:26rpx;font-size:33rpx;font-weight:700;color:#fff;text-shadow:0 2rpx 12rpx rgba(0,0,0,.25);line-height:1.4}.cover-question text{display:block}.kind-discovery .curiosity-cover{height:230rpx}.kind-question .cover-shade{background:linear-gradient(180deg,rgba(10,40,62,.05),rgba(10,40,62,.68))}
.curiosity-copy{padding:28rpx}.card-title{display:block;color:#153d55;font-size:32rpx;font-weight:700;line-height:1.5}.card-description{display:block;margin-top:12rpx;font-size:24rpx;color:#6b8090;line-height:1.75}.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid #eef2f4}.card-child{display:flex;align-items:center;gap:10rpx;color:#6a8291;font-size:21rpx;min-width:0}.child-dot{width:40rpx;height:40rpx;border-radius:50%;background:#e8f4f7;color:#36788b;display:flex;align-items:center;justify-content:center;font-size:20rpx;flex:none}.card-link{color:#197d9c;font-size:22rpx;font-weight:600;flex:none}.more-cards{width:100%!important;min-height:96rpx;border:1rpx solid #d1e5ed;border-radius:26rpx;background:#edf6fa;color:#277995;font-size:25rpx;line-height:1.5;padding:22rpx}.more-cards text{margin-left:16rpx}
.suggest{display:flex;align-items:flex-start;gap:20rpx;margin-top:32rpx;padding:28rpx;border-radius:28rpx;background:#eaf3ef;border:1rpx solid #dbe9e3}.suggest>image{width:36rpx;height:36rpx;flex:none;margin-top:4rpx}.suggest .caption{color:#568776;font-size:22rpx}.suggest .h3{margin-top:10rpx;font-size:26rpx;line-height:1.65;color:#315c4c}.guide{display:flex;align-items:center;gap:20rpx;width:100%!important;text-align:left;margin-top:24rpx;padding:26rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e1eaf0}.guide>view:nth-child(2){flex:1}.guide-icon{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#edf5f9}.guide-icon image{width:34rpx;height:34rpx}.guide .h3{font-size:27rpx}.guide .sub{font-size:22rpx;margin-top:5rpx}
.bottom-space{height:calc(160rpx + env(safe-area-inset-bottom))}.loading{padding:12rpx 0}.sk-hero{height:370rpx;border-radius:36rpx}.sk-card{height:180rpx;margin-top:24rpx;border-radius:30rpx}.state-wrap{padding:40rpx 26rpx;display:flex;flex-direction:column;align-items:center;text-align:center}.state-wrap .sub{margin-top:12rpx}.empty-art{width:300rpx;height:210rpx}.state-wrap .h2{font-size:32rpx}
@media(max-width:340px){.head .h1{font-size:37rpx}.hero-title{font-size:37rpx}.hero-label{font-size:20rpx}.hero-status{font-size:18rpx}.curiosity-copy{padding:24rpx}.card-bottom{flex-wrap:wrap;gap:14rpx}.card-title{font-size:30rpx}.section-title{font-size:32rpx!important}.inline-action{font-size:21rpx}}
