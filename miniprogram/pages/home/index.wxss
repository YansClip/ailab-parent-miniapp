.home {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.scroll { flex: 1; height: 0; }
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 16rpx;
  padding-bottom: 24rpx;
}
.greet { display: flex; flex-direction: column; }
.greet .sub { margin-top: 4rpx; }
.hero {
  height: 436rpx;
  border-radius: 48rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 16rpx 40rpx rgba(16, 42, 67, 0.08);
}
.hero-img { width: 100%; height: 100%; }
.hero-mask {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(16,42,67,0.82) 0%, rgba(16,42,67,0.18) 52%, rgba(16,42,67,0) 100%);
}
.hero-copy {
  position: absolute; left: 36rpx; bottom: 36rpx;
  color: #fff; display: flex; flex-direction: column;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; margin-top: 10rpx; }
.summary { padding: 32rpx; }
.metrics { display: flex; margin-top: 24rpx; }
.metric { width: 168rpx; display: flex; flex-direction: column; margin-right: 32rpx; }
.metric .sub { margin-top: 6rpx; }
.num { font-size: 44rpx; font-weight: 700; }
.num.lavender { color: #8b78e6; }
.num.green { color: #40b352; }
.num.butter { color: #f2a84a; }
.section-row { display: flex; justify-content: space-between; align-items: center; }
.photo-card { padding: 24rpx; }
.photo-head { margin-bottom: 16rpx; }
.photo-head .pill { margin-right: 16rpx; }
.photo-title { flex: 1; font-size: 26rpx; font-weight: 700; color: #102a43; }
.photos { display: flex; margin-bottom: 16rpx; }
.photo { width: 208rpx; height: 156rpx; border-radius: 24rpx; margin-right: 16rpx; }
.photos .photo:last-child { margin-right: 0; }
.dyn {
  display: flex; align-items: flex-start;
  padding: 24rpx; border: 2rpx solid #e9e4ec; border-radius: 32rpx;
  margin-bottom: 20rpx; background: #fff;
}
.dyn-icon { width: 76rpx; height: 76rpx; border-radius: 38rpx; margin-right: 24rpx; }
.dyn-copy { flex: 1; display: flex; flex-direction: column; }
.dyn-copy .sub { margin-top: 8rpx; }
.dyn-title { font-size: 28rpx; font-weight: 500; }
.dyn-time { font-size: 20rpx; }
.dyn-time.lavender { color: #8b78e6; }
.dyn-time.mint { color: #40b352; }
.dyn-time.butter { color: #f2a84a; }
.dyn-time.coral { color: #e85d69; }
.ach-row { display: flex; }
.ach { flex: 1; border-radius: 36rpx; padding: 30rpx; display: flex; flex-direction: column; margin-right: 24rpx; }
.ach:last-child { margin-right: 0; }
.ach .pill { margin-bottom: 12rpx; }
.ach-title { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.ach-link { font-size: 22rpx; font-weight: 500; margin-top: 12rpx; }
.ach.lavender { background: #f0ebff; }
.ach.mint { background: #e9f8f2; }
.ach.lavender .ach-link { color: #8b78e6; }
.ach.mint .ach-link { color: #40b352; }
.all-btn { background: #eef8f1; color: #40b352; font-size: 24rpx; padding: 12rpx 16rpx; border-radius: 24rpx; }
.fp { margin-top: 24rpx; border-radius: 36rpx; padding: 30rpx 32rpx; display: flex; flex-direction: column; border: 2rpx solid #fff; }
.fp .sub, .fp .fp-title { margin-top: 16rpx; }
.fp-lavender { background: #f4eeff; }
.fp-butter { background: #fff6d9; }
.fp-mint { background: #eaf8f2; }
.fp-title { font-size: 32rpx; font-weight: 700; color: #102a43; }
.fp .pill.lavender { color: #8f6bff; }
.fp .pill.butter { color: #e5a900; }
.fp .pill.mint { color: #40b352; }
.suggest { background: #eaf6ff; border-radius: 40rpx; padding: 32rpx; display: flex; }
.bar { width: 8rpx; height: 72rpx; background: #68b8f7; border-radius: 4rpx; margin-right: 16rpx; }
.suggest-copy { display: flex; flex-direction: column; }
.suggest-copy .sub { margin-top: 6rpx; }
.todo-row { display: flex; }
.todo { flex: 1; border-radius: 32rpx; padding: 26rpx; display: flex; flex-direction: column; margin-right: 24rpx; }
.todo:last-child { margin-right: 0; }
.todo .sub, .todo-link { margin-top: 10rpx; }
.t-butter { background: #fff4cf; }
.t-coral { background: #fff0ef; }
.todo-title { font-size: 28rpx; font-weight: 700; }
.t-butter .todo-title, .t-butter .todo-link { color: #f2a84a; }
.t-coral .todo-title, .t-coral .todo-link { color: #e85d69; }
.todo-link { font-size: 22rpx; font-weight: 500; }
.guide { background: #fff; border-radius: 36rpx; padding: 30rpx; }
.pb { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.loading { padding-top: 80rpx; color: #61758a; }
