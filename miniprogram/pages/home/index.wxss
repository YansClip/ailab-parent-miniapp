.home{height:100vh;display:flex;flex-direction:column;overflow:hidden;background:#fffaf3}.scroll{flex:1;min-height:0}.head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:18rpx 0 28rpx}.greet{flex:1;min-width:0}.greet .h1{margin-top:6rpx;font-size:42rpx}.child-pill{width:auto !important;flex:none;min-width:182rpx;min-height:88rpx;padding:10rpx 12rpx;border-radius:28rpx;background:rgba(255,255,255,.92);box-shadow:0 8rpx 26rpx rgba(16,42,67,.08);display:flex;align-items:center}.child-avatar{width:58rpx;height:58rpx;border-radius:20rpx;color:#fff;font-size:25rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.child-pill-copy{flex:1;min-width:0;margin-left:12rpx;display:flex;flex-direction:column;text-align:left}.child-name{color:#102a43;font-size:25rpx;font-weight:700;line-height:1.2}.child-pill-copy .caption{font-size:19rpx}.chevron{width:34rpx;height:34rpx;opacity:.52;flex:none}
.hero{height:410rpx;border-radius:46rpx;overflow:hidden;position:relative;box-shadow:0 18rpx 48rpx rgba(44,49,91,.15)}.hero-img,.hero-mask{position:absolute;inset:0;width:100%;height:100%}.hero-mask{background:linear-gradient(180deg,rgba(16,42,67,.02) 26%,rgba(16,42,67,.78) 100%)}.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:32rpx;color:#fff;display:flex;flex-direction:column}.hero-kicker{font-size:21rpx;font-weight:600;letter-spacing:2rpx;opacity:.92}.hero-title{margin-top:8rpx;font-size:38rpx;line-height:1.25;font-weight:700}.hero-sub{margin-top:8rpx;font-size:24rpx;opacity:.92}
.hero-child{position:absolute;z-index:3;right:22rpx;top:22rpx;background:rgba(255,255,255,.94)}
.summary{margin-top:26rpx;padding:30rpx}.summary .sub{margin-top:4rpx}.device-chip{flex:none;min-height:50rpx;padding:8rpx 16rpx;border-radius:999rpx;display:flex;align-items:center;gap:10rpx;font-size:21rpx;font-weight:600}.device-chip.online{background:#e9f8f2;color:#278c3d}.device-chip.offline{background:#fff0ef;color:#cf4b58}.status-dot{width:13rpx;height:13rpx;border-radius:50%;background:currentColor;box-shadow:0 0 0 6rpx rgba(64,179,82,.1)}.metrics{display:flex;gap:12rpx;margin-top:26rpx}.metric{flex:1;min-width:0;padding:18rpx 12rpx;border-radius:28rpx;background:#fafbfc;display:flex;flex-direction:column;align-items:center}.metric .icon-box{width:62rpx;height:62rpx;border-radius:20rpx}.metric .icon-box image{width:34rpx;height:34rpx}.num{margin-top:8rpx;font-size:38rpx;font-weight:750;line-height:1.15}.num.lavender{color:#8874e8}.num.green{color:#40b352}.num.butter{color:#e9a33b}.metric .caption{font-size:20rpx}.section-block{margin-top:42rpx}
.empty-home{margin-top:32rpx;padding:34rpx;text-align:center;display:flex;flex-direction:column;align-items:center}.empty-home image{width:360rpx;height:250rpx}.empty-home .h2{margin-top:12rpx}.empty-home .sub{margin:12rpx 0 28rpx}
.photo-card{width:100% !important;min-height:414rpx;padding:18rpx;display:flex;flex-wrap:wrap;gap:12rpx;text-align:left;overflow:hidden}.photo-main{width:65%;height:268rpx;border-radius:30rpx}.photo-side{flex:1;height:268rpx;display:flex;flex-direction:column;gap:12rpx}.photo-small{width:100%;height:128rpx;border-radius:24rpx}.photo-caption{width:100%;display:flex;align-items:center;justify-content:space-between;padding:8rpx 8rpx 2rpx}.photo-title{display:block;font-size:28rpx;font-weight:700;color:#102a43}.photo-caption .caption{margin-top:3rpx}.photo-arrow{width:58rpx;height:58rpx;border-radius:20rpx;background:#f1edff;display:flex;align-items:center;justify-content:center}.photo-arrow image{width:30rpx;height:30rpx}
.timeline{padding:28rpx 26rpx}.dyn{display:flex;align-items:stretch}.timeline-rail{width:78rpx;flex:none;display:flex;flex-direction:column;align-items:center}.dyn-icon-wrap{width:66rpx;height:66rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center}.dyn-icon-wrap.lavender{background:#f1edff}.dyn-icon-wrap.mint{background:#e9f8f2}.dyn-icon-wrap.butter{background:#fff4d2}.dyn-icon-wrap.coral{background:#fff0ef}.dyn-icon{width:36rpx;height:36rpx}.timeline-line{flex:1;width:2rpx;min-height:38rpx;margin:8rpx 0;background:#e5eaee}.dyn-copy{flex:1;min-width:0;padding:7rpx 0 30rpx 16rpx}.dyn-copy .between{align-items:flex-start;gap:16rpx}.dyn-title{flex:1;min-width:0;font-size:28rpx;font-weight:650;color:#102a43}.dyn-copy .sub{margin-top:8rpx}.dyn:last-child .dyn-copy{padding-bottom:4rpx}
.ach-scroll{width:calc(100% + 36rpx);margin-right:-36rpx}.ach-row{display:flex;gap:20rpx;width:max-content;padding:3rpx 36rpx 20rpx 0}.ach{width:394rpx !important;min-height:438rpx;overflow:hidden;text-align:left;flex:none}.ach-image{width:100%;height:224rpx}.ach-copy{padding:22rpx 24rpx 26rpx}.ach-title{display:block;margin-top:12rpx;font-size:30rpx;line-height:1.35;font-weight:700;color:#102a43}.ach-copy .sub{margin-top:6rpx}.ach-link{display:block;margin-top:14rpx;font-size:23rpx;color:#278c3d;font-weight:650}
.fp{width:100% !important;min-height:236rpx;margin-top:18rpx;padding:28rpx 30rpx;border-radius:36rpx;text-align:left;box-shadow:0 8rpx 24rpx rgba(16,42,67,.055)}.fp-lavender{background:linear-gradient(135deg,#f3efff,#fbf9ff)}.fp-butter{background:linear-gradient(135deg,#fff1bf,#fffaf0)}.fp-mint{background:linear-gradient(135deg,#e7f8f0,#f8fffb)}.fp-title{display:block;margin-top:18rpx;font-size:31rpx;line-height:1.3;font-weight:700;color:#102a43}.fp .sub{margin-top:9rpx}.fp-foot{margin-top:22rpx;display:flex;align-items:center;gap:6rpx;color:#61758a;font-size:23rpx;font-weight:600}.fp-foot image{width:27rpx;height:27rpx;opacity:.65}
.suggest{padding:28rpx;border-radius:36rpx;background:linear-gradient(135deg,#eaf6ff,#f6fbff);display:flex;align-items:flex-start;gap:22rpx;box-shadow:0 8rpx 24rpx rgba(64,133,184,.08)}.suggest-copy{flex:1;min-width:0}.suggest-copy .sub{margin-top:8rpx}.todo-list{display:flex;flex-direction:column;gap:16rpx}.todo{width:100% !important;min-height:122rpx;padding:22rpx;display:flex;align-items:center;gap:18rpx;text-align:left}.todo .icon-box{width:68rpx;height:68rpx;border-radius:22rpx}.todo .icon-box image{width:36rpx;height:36rpx}.todo-copy{flex:1;min-width:0}.todo-title{display:block;font-size:27rpx;font-weight:700;color:#102a43}.todo-copy .sub{margin-top:4rpx}.guide{width:100% !important;padding:26rpx;display:flex;align-items:center;gap:20rpx;text-align:left}.guide-copy{flex:1;min-width:0}.guide-copy .sub{margin-top:4rpx}
.pb{padding-bottom:calc(168rpx + env(safe-area-inset-bottom))}.loading{padding-top:28rpx}.sk-line{width:62%;height:54rpx;border-radius:20rpx;margin-bottom:28rpx}.sk-line.short{width:44%;margin-top:32rpx}.sk-hero{height:410rpx;border-radius:46rpx}.sk-card{height:220rpx;border-radius:40rpx;margin-top:28rpx}.state-wrap{min-height:82vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.state-art{width:420rpx;height:300rpx}.state-wrap .sub{margin-top:12rpx}.state-btn{margin-top:32rpx}
.greet .h1{font-size:36rpx;white-space:nowrap}.child-pill{min-width:164rpx}
@media(max-width:340px){.head{gap:12rpx}.greet .h1{font-size:34rpx}.child-pill{min-width:154rpx}.hero{height:370rpx}.summary{padding:25rpx}.metrics{gap:7rpx}.metric{padding:16rpx 6rpx}.ach{width:360rpx}.photo-main,.photo-side{height:238rpx}.photo-small{height:113rpx}}
