<view class="page"><nav-bar title="兴趣足迹" /><view class="pad" wx:if="{{loading}}"><view class="skeleton detail-skeleton"></view></view><view class="pad" wx:elif="{{error}}"><view class="card card-p"><text class="h2">暂时无法查看</text><text class="sub mt-12">{{error}}</text><button class="btn btn-secondary mt-24" bindtap="load">重新加载</button></view></view><view class="pad" wx:else><view class="between"><text class="pill pill-sky">{{item.type}}</text><button class="follow-button {{item.followed ? 'followed' : ''}}" loading="{{busy}}" disabled="{{busy}}" bindtap="toggle">{{item.followed ? '已关注' : '+ 关注足迹'}}</button></view><text class="h1 mt-20">{{item.title}}</text><text class="sub mt-12">{{item.date}} · {{item.scene}}</text><view class="card card-p mt-24"><text class="h3">事件摘要</text><text class="sub mt-12">{{item.summary || '尚无事件摘要'}}</text></view><view class="card card-p mt-16"><text class="h3">关联概念</text><view class="concepts mt-12"><text class="pill pill-sky" wx:for="{{item.concepts}}" wx:key="*this">{{item}}</text><text class="sub" wx:if="{{!item.concepts.length}}">未标注关联概念</text></view></view><view class="card card-p mt-16"><text class="h3">后续探索</text><text class="sub mt-12">{{item.follow || '还没有后续探索记录'}}</text></view><view class="card card-p mt-16"><text class="h3">关联探索内容</text><text class="sub mt-12">{{item.courseId}} · {{item.scene}}</text><text class="caption mt-12">记录编号：{{item.id}}</text></view><text class="sub mt-20">来源：{{item.source}}。足迹仅家庭可见，关注不会形成公开点赞或排名。</text></view></view>
