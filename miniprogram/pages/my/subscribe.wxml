<view class="page">
  <nav-bar title="微信订阅消息" />
  <view class="pad">
    <text class="h1">由你主动授权</text>
    <text class="sub mt-12">拒绝或发送失败时，站内消息仍完整保留。不承诺永久订阅。</text>
    <view class="item mt-20 between"><text>设备离线提醒</text><text class="status">{{enabled ? '已授权' : '未授权'}}</text></view>
    <view class="item between"><text>成长报告完成</text><text class="status">{{enabled ? '已授权' : '未授权'}}</text></view>
    <button class="btn {{enabled ? 'btn-secondary' : 'btn-primary'}} mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="ask">{{enabled ? '关闭演示订阅' : '申请订阅'}}</button>
    <text class="status mt-12" wx:if="{{task}}">{{task.message}}</text>
  </view>
</view>
