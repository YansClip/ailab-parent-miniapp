<view class="page">
  <nav-bar title="微信订阅消息" />
  <view class="pad">
    <text wx:if="{{loading}}" class="qa-note" role="status">正在获取信息…</text>
    <view wx:if="{{error}}" class="card card-p"><text class="danger">{{error}}</text><button class="btn btn-secondary mt-12" bindtap="reload">重新加载</button></view>
    <view class="subscribe-hero"><view class="icon-box icon-butter"><image src="/assets/icons/lucide/notice.png" mode="aspectFit" /></view><text class="h1">重要消息及时知道</text><text class="sub">订阅由你主动授权；未授权时，消息仍会完整保留在消息中心。</text></view>
    <view class="item mt-20 between"><view class="reminder-main"><view class="icon-box icon-coral"><image src="/assets/icons/lucide/device.png" mode="aspectFit" /></view><view><text class="h3">设备离线提醒</text><text class="sub">设备长时间离线时提醒</text></view></view><text class="status">{{enabled ? '本地偏好已开启' : '本地偏好未开启'}}</text></view>
    <view class="item between"><view class="reminder-main"><view class="icon-box icon-lavender"><image src="/assets/icons/lucide/document.png" mode="aspectFit" /></view><view><text class="h3">成长报告完成</text><text class="sub">新报告生成后提醒查看</text></view></view><text class="status">{{enabled ? '本地偏好已开启' : '本地偏好未开启'}}</text></view>
    <button class="btn {{enabled ? 'btn-secondary' : 'btn-primary'}} mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="ask">{{enabled ? '关闭示例订阅' : '体验订阅设置'}}</button>
    <text class="status mt-12" wx:if="{{task}}">{{task.message}}</text>
  </view>
</view>
