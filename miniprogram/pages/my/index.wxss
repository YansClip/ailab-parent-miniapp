.me{height:100vh;display:flex;flex-direction:column;overflow:hidden;padding-bottom:0;background:linear-gradient(180deg,#eaf5fa,#f5f8fa 650rpx)}.scroll{flex:1;height:0}.title-row{display:flex;align-items:center;justify-content:space-between;padding-top:calc(44px + 24rpx);padding-bottom:28rpx}.title-row .h1{font-size:42rpx;margin-top:8rpx}.eyebrow{display:block;font-size:20rpx;color:#4b899b;letter-spacing:2rpx}.notice-pill{padding:8rpx 14rpx;border-radius:14rpx;background:#deedf3;color:#5b8296;font-size:20rpx}
.profile{width:100%!important;margin:0;padding:28rpx;display:flex;align-items:center;border-radius:32rpx;background:#fff;text-align:left;line-height:1.4;border:1rpx solid #e2ebef}.avatar{width:106rpx;height:106rpx;border-radius:36rpx;background:#eaf5f7;margin-right:22rpx;border:5rpx solid #e8f1f5;flex:none}.meta{flex:1;min-width:0;display:flex;flex-direction:column}.meta .row{flex-wrap:wrap;gap:8rpx}.meta .sub{margin-top:6rpx;font-size:23rpx}.profile-name{font-size:34rpx;font-weight:700;color:#163e55}.role-pill{padding:5rpx 10rpx;border-radius:10rpx;background:#e7f3f6;color:#287b94;font-size:19rpx}.family-name{margin-top:6rpx;font-size:24rpx;color:#287b94}.profile-chevron{width:34rpx;height:34rpx;opacity:.5;margin-left:16rpx;flex:none}
.guardian-card{min-height:270rpx;padding:28rpx;border-radius:32rpx;background:linear-gradient(135deg,#e0eff3,#edf6ef);position:relative;overflow:hidden;border:1rpx solid #d7e9e9}.guardian-device{position:absolute;right:-10rpx;top:12rpx;width:190rpx;height:190rpx}.guardian-content{position:relative;z-index:2}.guardian-head{padding-right:112rpx;align-items:flex-start;gap:10rpx}.guardian-copy{flex:1;min-width:0}.guardian-title{display:block;font-size:28rpx;font-weight:700;color:#204b5a;line-height:1.4}.guardian-card .sub{display:block;margin-top:6rpx;font-size:22rpx}.guardian-card .pill{font-size:20rpx;padding:6rpx 12rpx;min-height:40rpx}.guardian-metrics{display:flex;gap:10rpx;margin-top:26rpx}.guardian-metrics view{flex:1;min-width:0;display:flex;flex-direction:column;padding:16rpx 12rpx;border-radius:20rpx;background:rgba(255,255,255,.7)}.guardian-metrics view text:first-child{font-size:30rpx;font-weight:700;color:#2a7985}
.feedback-section{margin-top:28rpx}.feedback-feature{position:relative;width:100%!important;min-height:350rpx;padding:30rpx;border:1rpx solid #eed7a4;border-radius:32rpx;background:linear-gradient(125deg,#fff3d4,#ffe8b4);text-align:left;overflow:hidden;line-height:1.5;box-shadow:0 12rpx 30rpx rgba(140,104,31,.07)}.feedback-top{display:flex;align-items:center;justify-content:space-between}.feedback-kicker{display:flex;align-items:center;gap:12rpx;color:#8b6d35;font-size:23rpx}.feedback-kicker image{width:30rpx;height:30rpx}.feedback-arrow{font-size:42rpx;line-height:1;color:#9b7629}.feedback-title{display:block;margin-top:22rpx;font-size:40rpx;font-weight:700;line-height:1.35;color:#4e421f}.feedback-title text{display:block}.feedback-desc{display:block;margin-top:16rpx;font-size:24rpx;color:#8c7748;line-height:1.7}.feedback-desc text{display:block}.feedback-cta{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(169,130,50,.2);font-size:25rpx;font-weight:650;color:#765819}.feedback-cta text:last-child{font-size:23rpx;font-weight:500}
.menu-group{margin-top:34rpx}.menu-group .section-title{display:block;font-size:30rpx;margin-bottom:16rpx;color:#23485d}.menu{background:#fff;border-radius:30rpx;overflow:hidden;box-shadow:0 8rpx 24rpx rgba(16,42,67,.035)}.menu-row{width:100%!important;min-height:126rpx;margin:0;display:flex;justify-content:space-between;align-items:center;padding:24rpx;border-bottom:1rpx solid #edf2f5;background:#fff;text-align:left;line-height:1.4}.menu-row:last-child{border-bottom:0}.left{display:flex;align-items:center;flex:1;min-width:0}.menu-icon{width:70rpx;height:70rpx;flex:none;border-radius:22rpx;margin-right:20rpx;display:flex;align-items:center;justify-content:center}.menu-icon image{width:36rpx;height:36rpx}.menu-chev{width:32rpx;height:32rpx;opacity:.5;flex:none;margin-left:12rpx}.tone-lavender,.tone-sky{background:#eaf4f8}.tone-mint{background:#eaf5ef}.tone-butter{background:#fff3d4}.tone-coral{background:#fff0e6}.tone-neutral{background:#eff3f5}.menu-copy{display:flex;flex-direction:column;flex:1;min-width:0}.menu-copy .sub{margin-top:5rpx;font-size:23rpx}.name{font-size:28rpx;font-weight:650;color:#23485d}.pb{height:calc(162rpx + env(safe-area-inset-bottom))}.sk-profile{height:164rpx;border-radius:32rpx}.sk-status{height:270rpx;border-radius:32rpx;margin-top:28rpx}.sk-list{height:400rpx;border-radius:32rpx;margin-top:28rpx}
@media(max-width:340px){.title-row .h1{font-size:37rpx}.guardian-title{font-size:26rpx}.guardian-head{padding-right:96rpx}.guardian-device{width:170rpx;height:170rpx}.guardian-card .sub{font-size:21rpx}.feedback-title{font-size:37rpx}.profile-name{font-size:31rpx}.guardian-metrics .sub{font-size:20rpx}}
