<view class="page">
  <nav-bar title="意见反馈" />
  <view class="pad">
    <view wx:if="{{submitted}}" class="feedback-success"><image src="/assets/icons/lucide/check.png" mode="aspectFit" /><text class="h1">问题已提交</text><text class="sub">可在“专属支持”查看处理进度，我们会尽快跟进。</text><button class="btn btn-secondary mt-24" bindtap="again">继续反馈</button></view>
    <block wx:else>
    <view class="edit-hero"><view class="icon-box icon-coral"><image src="/assets/icons/lucide/support.png" mode="aspectFit" /></view><view><text class="h2">告诉我们遇到的问题</text><text class="sub">描述越具体，越容易快速定位</text></view></view>
    <text class="form-label">问题类型</text>
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="item between"><text>{{categories[categoryIndex]}}</text><text class="link">修改</text></view></picker>
    <text class="form-label mt-16">问题描述</text>
    <textarea class="textarea" value="{{text}}" maxlength="500" placeholder="描述问题，可选择是否附带必要日志" bindinput="onInput" />
    <text class="sub mt-8">{{count}} / 500</text>
    <button class="btn btn-primary mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="send">提交</button>
    </block>
  </view>
</view>
