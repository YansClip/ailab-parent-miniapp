@import "../../styles/detail.wxss";
.feedback-body{padding-top:30rpx;padding-bottom:60rpx}.edit-hero{display:flex;flex-direction:column;align-items:flex-start;padding:28rpx 4rpx 36rpx;gap:16rpx}.edit-hero .icon-box{background:#ffe7ba;width:90rpx;height:90rpx;border-radius:28rpx}.edit-hero .icon-box image{width:42rpx;height:42rpx}.feedback-eyebrow{font-size:23rpx;color:#9a712f;font-weight:600}.edit-hero .h1{font-size:44rpx;line-height:1.35}.edit-hero .sub{font-size:25rpx;line-height:1.8}.edit-hero .sub text{display:block}
.feedback-form{padding:28rpx;background:#fff;border:1rpx solid #e2edf2;border-radius:32rpx;box-shadow:0 12rpx 30rpx rgba(23,61,83,.05)}.form-label{display:block;font-size:26rpx;color:#25485d;font-weight:650}.category-field{min-height:92rpx;border:1rpx solid #dfeaf0;border-radius:22rpx;padding:22rpx;margin-top:16rpx;background:#f7fafc;font-size:27rpx}.category-field .link{font-size:23rpx}.description-label{margin-top:32rpx}.feedback-input{width:100%;height:380rpx;min-height:380rpx;margin-top:16rpx;padding:24rpx;border-radius:24rpx;background:#f7fafc;border:1rpx solid #dfeaf0;font-size:27rpx;line-height:1.8;color:#25485d}.input-footer{display:flex;justify-content:space-between;gap:12rpx;margin-top:16rpx;color:#7b929e;font-size:22rpx}.feedback-submit{margin-top:32rpx;background:#176a86;min-height:104rpx;border-radius:26rpx;font-size:28rpx}.feedback-submit.is-disabled{background:#d8e7ec;color:#7593a1;opacity:1}.feedback-note{display:block;margin:22rpx 8rpx 0;color:#8398a4;font-size:22rpx;line-height:1.7}.feedback-success{min-height:72vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.feedback-success image{width:110rpx;height:110rpx;margin-bottom:26rpx}.feedback-success .h1{font-size:42rpx}.feedback-success .sub{margin-top:20rpx;line-height:1.8}.feedback-success .btn{margin-top:40rpx}
