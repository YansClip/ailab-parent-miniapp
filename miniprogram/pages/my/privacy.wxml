<view class="page"><nav-bar title="儿童信息" /><view class="pad">
  <text class="h1">儿童信息管理</text><text class="sub mt-12">当前孩子：{{child.name || '正在获取'}}。仅主管理员可查看完整资料及更正。</text>
  <text class="qa-note mt-12">演示数据 · 本页操作只处理本地示例资料</text>
  <view wx:if="{{error}}" class="card card-p mt-12"><text class="danger">{{error}}</text><button class="btn btn-secondary mt-12" bindtap="reload">重试</button></view>
  <block wx:if="{{isAdmin && !loading && !error}}">
    <view class="card card-p mt-20"><text class="h3">当前可查看范围</text><text class="sub mt-8">孩子称呼、年龄、家庭关系、设备关联、互动成果及成长记录。</text><button class="btn btn-secondary mt-16" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">查看资料摘要</button>
      <view class="mt-12" wx:if="{{result}}"><text class="sub">称呼：{{child.name}}</text><text class="sub">年龄：{{child.age || '未提供'}}</text><text class="sub">设备：{{child.deviceName || '尚未绑定'}}</text><text class="sub">完整互动记录可在首页和成长页查看。</text></view>
    </view>
    <view class="card card-p mt-20"><text class="h3">更正资料</text><text class="sub mt-8">孩子称呼</text><input class="input mt-8" value="{{name}}" maxlength="20" bindinput="inputName" /><text class="sub mt-12">更正说明（选填）</text><textarea class="textarea mt-8" value="{{note}}" maxlength="200" bindinput="inputNote" placeholder="说明更正原因" /><button class="btn btn-primary mt-16" bindtap="correct" disabled="{{busy}}" loading="{{busy}}">保存更正</button></view>
  </block>
  <text class="sub mt-12" wx:if="{{!loading && !isAdmin}}">请联系家庭主管理员处理儿童资料。</text>
  <view class="task-state mt-16" wx:if="{{task}}"><text class="sub">{{task.message}}</text></view>
</view></view>
