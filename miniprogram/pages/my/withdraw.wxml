<view class="page">
  <nav-bar title="撤回同意" />
  <view class="pad">
    <view class="risk-hero"><view class="risk-icon"><image src="/assets/icons/lucide/privacy.png" mode="aspectFit" /></view><text class="h1">撤回隐私授权</text><text class="sub">提交前请了解对家庭服务的影响</text></view>
    <view class="card card-p mt-20"><text class="h3">撤回后将发生</text><view class="impact-row"><text>停止新增位置、设备与成长相关数据</text></view><view class="impact-row"><text>部分守护与成长功能将无法继续使用</text></view><view class="impact-row"><text>依法需要保留的信息会说明范围与期限</text></view></view>
    <button class="btn btn-danger mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">确认撤回</button>
    <view class="task-state mt-16 {{task.status==='success' ? 'success' : task.status==='failed' ? 'failed' : ''}}" wx:if="{{task}}"><view class="task-state-dot"></view><view class="task-state-copy"><text class="h3">申请进度</text><text class="sub">{{task.message}}</text></view></view>
  </view>
</view>
