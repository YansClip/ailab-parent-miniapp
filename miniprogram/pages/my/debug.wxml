<view class="page">
  <nav-bar title="演示场景" />
  <view class="pad">
    <text class="sub">用于对照原型空/加载/离线/失败状态。不影响正式产品文案。</text>
    <button class="item list-button" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="pick" aria-label="切换演示场景：{{item.name}}">
      <text class="h3">{{item.name}}</text>
      <text class="status" wx:if="{{item.id === current}}">当前</text>
    </button>
    <button class="btn btn-danger mt-24" bindtap="reset">重置全部本地数据</button>
    <text class="sub mt-12">会恢复联系人、闹钟、家庭邀请、已读消息、设备绑定和当前孩子。</text>
  </view>
</view>
