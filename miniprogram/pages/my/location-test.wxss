@import '../../styles/detail.wxss';
.lab-heading{padding-top:8rpx}.lab-tag{display:inline-block;padding:9rpx 18rpx;border-radius:8rpx;background:#def0eb;color:#246655;font-size:22rpx;font-weight:600}.lab-boundary{padding:20rpx 24rpx;background:#e9f3f7;border-left:5rpx solid #157eaf;border-radius:4rpx 14rpx 14rpx 4rpx;font-size:24rpx;line-height:1.7;color:#4e697b}.lab-title-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.lab-caption{display:block;font-size:22rpx;color:#728a98}.lab-board{height:330rpx;margin:28rpx 0;border:1rpx solid #d9e7ed;border-radius:18rpx;position:relative;overflow:hidden;background-color:#f1f7f9;background-image:linear-gradient(#dfeaf0 1rpx,transparent 1rpx),linear-gradient(90deg,#dfeaf0 1rpx,transparent 1rpx);background-size:44rpx 44rpx}.lab-north,.lab-grid-label{position:absolute;font-size:20rpx;color:#7d97a5}.lab-north{right:18rpx;top:14rpx}.lab-grid-label{left:18rpx;bottom:14rpx}.lab-marker{position:absolute;transform:translate(-50%,-50%);width:52rpx;height:52rpx;line-height:44rpx;text-align:center;border:5rpx solid #fff;border-radius:50%;background:#087f94;color:white;font-size:24rpx;font-weight:600;box-shadow:0 0 0 16rpx rgba(8,127,148,.12)}.lab-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:26rpx;color:#7c939f}.lab-good{color:#087f94}.lab-warn{color:#936026}.lab-metrics{display:flex;justify-content:space-between;border-top:1rpx solid #e0e9ee;padding-top:22rpx;gap:20rpx}.lab-value{display:block;margin-top:8rpx;font-size:25rpx;color:#234d63;font-weight:600}.lab-error{display:block;color:#955031;background:#fff2e6;padding:22rpx;border-radius:12rpx;font-size:25rpx;line-height:1.65}.lab-receipt{display:block;padding:20rpx;border-left:4rpx solid #087f94;background:#edf6f4;font-size:25rpx;line-height:1.7;color:#426d64}.lab-code{letter-spacing:5rpx}
