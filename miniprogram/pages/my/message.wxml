<view class="page">
  <nav-bar title="消息中心" action="订阅" bind:action="sub" />
  <view class="pad">
    <view class="message-hero"><view class="icon-box icon-butter"><image src="/assets/icons/lucide/message.png" mode="aspectFit" /></view><view><text class="h2">家庭消息</text><text class="sub">守护提醒、成长通知与家庭协作集中查看</text></view></view>
    <empty-state wx:if="{{loaded && !list.length}}" title="暂无消息" desc="家庭邀请、守护提醒与成长通知会显示在这里。" />
    <button class="item list-button" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-url="{{item.url}}" hover-class="pressed" bindtap="open" aria-label="打开消息：{{item.title}}">
      <view class="between">
        <view class="message-type"><image src="/assets/icons/lucide/message.png" mode="aspectFit" /><text class="pill pill-lavender">{{item.type}}</text></view>
        <text class="sub">{{item.time}}</text>
      </view>
      <text class="h3 mt-8">{{item.title}}</text>
      <text class="status" wx:if="{{item.unread}}">未读</text>
    </button>
  </view>
</view>
