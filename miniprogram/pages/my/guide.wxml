<view class="page">
  <nav-bar title="玩机指南" />
  <view class="pad">
    <view class="guide-hero"><view class="icon-box icon-mint"><image src="/assets/icons/lucide/guide.png" mode="aspectFit" /></view><view><text class="h1">轻松上手 Mini</text><text class="sub">从绑定设备到守护工具，一步一步完成设置</text></view></view>
    <button class="item list-button" wx:for="{{list}}" wx:key="id" data-url="{{item.url}}" hover-class="pressed" bindtap="open" aria-label="查看指南：{{item.title}}">
      <view class="guide-row"><view class="guide-number">{{index + 1}}</view><view class="guide-copy"><text class="h3">{{item.title}}</text><text class="sub">{{item.desc}}</text><text class="status">{{item.status}}</text></view><image class="row-chevron" src="/assets/icons/lucide/chevron.png" mode="aspectFit" /></view>
    </button>
  </view>
</view>
