<view class="page">
  <nav-bar title="设备中心" />
  <view class="pad">
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" hover-class="pressed" bindtap="detail">
      <view class="between">
        <view>
          <text class="h3">{{item.name}}</text>
          <text class="sub">{{item.childName}} · {{item.locate}} · {{item.updatedAt}}</text>
        </view>
        <text class="status">{{item.online ? '在线' : '离线'}} {{item.battery}}%</text>
      </view>
    </view>
  </view>
</view>
