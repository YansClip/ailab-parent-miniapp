<view class="page">
  <nav-bar title="申请删除" />
  <view class="pad">
    <view class="risk-hero"><view class="risk-icon"><image src="/assets/icons/lucide/trash.png" mode="aspectFit" /></view><text class="h1">删除当前孩子的探索记录</text><text class="sub">删除完成后相关记录将无法恢复</text></view>
    <view class="card card-p mt-20"><text class="h3">申请范围</text><view class="impact-row"><text>当前孩子的互动与实验记录</text></view><view class="impact-row"><text>成长报告、探索成果和关注记录</text></view><view class="impact-row"><text>保留家庭关系与设备关联，不影响其他孩子</text></view><text class="caption mt-12">演示数据仅保存在本机，本操作不代表真实后台已删除儿童资料。</text></view>
    <button class="btn btn-danger mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交删除申请</button>
    <view class="task-state mt-16 {{task.status==='success' ? 'success' : task.status==='failed' ? 'failed' : ''}}" wx:if="{{task}}"><view class="task-state-dot"></view><view class="task-state-copy"><text class="h3">处理进度</text><text class="sub">{{task.message}}</text></view></view>
    <button wx:if="{{task.status==='timeout'}}" class="btn btn-secondary mt-16" bindtap="queryTask" disabled="{{busy}}">查询最终状态</button>
  </view>
</view>
