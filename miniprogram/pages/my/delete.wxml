<view class="page">
  <nav-bar title="申请删除" />
  <view class="pad">
    <text class="h1">删除儿童相关数据</text>
    <text class="sub mt-12">高风险操作。完成后可在此查询处理进度，不会仅以前端成功提示结束。</text>
    <button class="btn btn-danger mt-24" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交删除申请</button>
    <text class="status mt-12" wx:if="{{task}}">{{task.message}}</text>
  </view>
</view>
