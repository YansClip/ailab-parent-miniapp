.err { margin-top: 24rpx; color: #e85d69; font-size: 26rpx; }
.bind-hero{display:flex;align-items:center;gap:20rpx;padding:26rpx;border-radius:34rpx;background:linear-gradient(145deg,#f1edff,#fbf9ff);margin-bottom:30rpx}.qr-icon{width:82rpx;height:82rpx;border-radius:26rpx;background:#fff;display:flex;align-items:center;justify-content:center}.qr-icon image{width:46rpx;height:46rpx}.scan-button{width:100% !important;padding:26rpx;border-radius:30rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(16,42,67,.07);display:flex;align-items:center;gap:20rpx;text-align:left}.scan-button>image{width:58rpx;height:58rpx}.divider{display:flex;align-items:center;gap:16rpx;margin:28rpx 0;color:#829ab1;font-size:22rpx}.divider view{flex:1;height:1rpx;background:#dfe7ed}.code-input{text-align:center;font-size:38rpx;letter-spacing:18rpx;padding-left:46rpx}
