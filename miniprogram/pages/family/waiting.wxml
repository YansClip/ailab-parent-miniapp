<view class="page">
  <nav-bar title="确认绑定" />
  <view class="pad">
    <view class="waiting-visual"><view class="waiting-ring"></view><image src="/assets/illustrations/mini-device-v2.png" mode="aspectFit" /></view>
    <text class="h1">正在安全确认绑定关系</text>
    <text class="sub mt-12">已提交监护关系。等待孩子确认或主管理员确认，确认完成前不会展示儿童敏感信息。</text>
    <view class="card status mt-24">
      <text class="h3">{{statusText}}</text>
      <view class="progress-track mt-16"><view class="progress-fill" style="width: {{failed ? 38 : 72}}%"></view></view>
      <text class="sub mt-8">{{failed ? '没有确认成功，可重新查询' : '通常会在几秒内完成，请保持网络连接'}}</text>
    </view>
    <button class="btn btn-secondary mt-24" wx:if="{{failed}}" hover-class="pressed" bindtap="refresh">失败重试</button>
    <button class="btn btn-secondary mt-24" wx:elif="{{!polling}}" hover-class="pressed" bindtap="refresh">查询最终状态</button>
  </view>
</view>
