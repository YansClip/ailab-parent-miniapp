.growth{height:100vh;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box;padding-bottom:0;color:#173d53;background:linear-gradient(180deg,#eaf5fa,#f5f8fa 650rpx)}.scroll{flex:1;height:0}.head{display:flex;align-items:center;justify-content:space-between;padding-top:24rpx;padding-bottom:28rpx;gap:16rpx}.head .h1{font-size:42rpx;margin-top:8rpx}.eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#4b899b}.switch-button{width:auto!important;flex:none;margin:0!important;min-height:88rpx;padding:16rpx 22rpx;background:rgba(255,255,255,.85);color:#175d7c;border:1rpx solid #d3e6ee;border-radius:28rpx;font-size:24rpx;line-height:1.4}
.growth-hero{height:266rpx;position:relative;overflow:hidden;border-radius:32rpx;background:#157ca4;box-shadow:0 12rpx 30rpx rgba(18,58,99,.1)}.growth-hero>image,.growth-hero-mask{position:absolute;inset:0;width:100%;height:100%}.growth-hero-mask{background:linear-gradient(90deg,rgba(9,47,75,.9),rgba(13,70,110,.08))}.growth-hero-copy{position:absolute;left:28rpx;top:24rpx;bottom:24rpx;right:24rpx;display:flex;flex-direction:column;color:#fff;justify-content:space-between}.hero-kicker{font-size:21rpx;opacity:.8}.hero-title{font-size:39rpx;font-weight:700;line-height:1.3;letter-spacing:1rpx}.hero-title text{display:block}.hero-sub{font-size:21rpx;opacity:.85}.growth-demo{position:absolute;right:0;bottom:0;font-size:18rpx;opacity:.7}
.brief{margin-top:24rpx;width:100%!important;padding:28rpx;border:1rpx solid #dedcbd;border-radius:30rpx;background:#f4f1df;text-align:left;line-height:1.5;position:relative}.brief-heading{display:flex;align-items:center;gap:10rpx}.brief-heading image{width:30rpx;height:30rpx}.brief .h3{font-size:27rpx;color:#695d32}.brief-link{font-size:22rpx;color:#8e7c3e;flex:none}.brief-question{display:block;margin:20rpx 0 14rpx;color:#4b472c;font-size:34rpx;font-weight:700;line-height:1.5}.brief .sub{font-size:23rpx;color:#8c815d}
.progress-card{padding:28rpx;border-radius:30rpx}.progress-card .h3{font-size:30rpx}.progress-card .sub{font-size:23rpx;margin-top:8rpx}.progress-number{font-size:55rpx;font-weight:750;color:#1a839b;flex:none;margin-left:10rpx}.progress-number text{font-size:25rpx;color:#7e9aaa;font-weight:500}.progress-track{height:16rpx;border-radius:20rpx;background:#e7f0f3;margin-top:24rpx;overflow:hidden}.progress-track>view{height:100%;border-radius:20rpx;background:linear-gradient(90deg,#2589a6,#62c3bf)}.progress-meta{margin-top:14rpx;gap:10rpx}.progress-meta .caption{font-size:21rpx}.plan-toggle{background:#f0f6f8;border-radius:18rpx;color:#337991;width:100%!important;min-height:88rpx;padding:18rpx;font-size:24rpx;line-height:1.4;margin:22rpx 0 0!important}.plan-list{margin-top:20rpx;border-top:1rpx solid #e6f0f5}.lesson{display:flex;align-items:center;gap:15rpx;padding:22rpx 0;border-bottom:1rpx solid #edf3f7}.lesson-id{font-size:21rpx;color:#83a2b6;flex:none;width:54rpx}.lesson-copy{display:flex;flex-direction:column;gap:5rpx;flex:1;min-width:0;font-size:24rpx}.lesson-status{font-size:21rpx;color:#95a9b7;flex:none}.lesson-status.completed{color:#158e9b}.lesson-status.available{color:#b4893b}
.radar{padding:28rpx;overflow:hidden;border-radius:30rpx}.radar .h3{font-size:30rpx}.radar>.sub{font-size:23rpx;line-height:1.7}.radar-wrap{display:flex;justify-content:center;margin:12rpx -28rpx}.radar-canvas{width:300px;height:278px}.dim-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.dim-chip{display:flex;flex-direction:column;text-align:left;width:100%!important;min-height:132rpx;margin:0!important;line-height:1.4;padding:20rpx;border-radius:22rpx;background:#f0f7f9;border:1rpx solid #e2eef2}.dim-name{font-size:24rpx;color:#577b8d}.dim-v{font-size:33rpx;font-weight:700;color:#237d96;margin-top:9rpx}.dim-count{font-size:21rpx;color:#7b96a4;margin-top:7rpx}.radar-note{display:block;font-size:21rpx;margin-top:22rpx;line-height:1.7;color:#7c939f}.radar-more{background:transparent;padding:18rpx 0 0;margin:0!important;width:100%!important;min-height:88rpx;color:#267e98;font-size:24rpx;line-height:1.4}
.section-block{margin-top:36rpx}.section-title{font-size:32rpx!important;font-weight:700;color:#173d53}.section-lead .caption{font-size:21rpx}.rep{width:100%!important;margin-top:16rpx;padding:26rpx;display:flex;align-items:center;gap:18rpx;text-align:left;border-radius:28rpx}.report-icon{width:70rpx;height:78rpx;background:#eaf3f7;border-radius:22rpx;display:flex;align-items:center;justify-content:center;flex:none}.report-icon image{width:34rpx;height:34rpx}.report-copy{flex:1;min-width:0}.report-copy .h3{font-size:28rpx}.report-copy .sub{font-size:22rpx;margin-top:6rpx}.report-status{flex:none;color:#3a8fa6;font-size:22rpx}.ach{display:flex;align-items:center;gap:18rpx;width:100%!important;margin-top:16rpx;padding:18rpx;text-align:left;border-radius:28rpx}.ach-thumb{width:154rpx;height:140rpx;border-radius:22rpx;flex:none}.ach-meta{flex:1;min-width:0}.ach-meta .h3{font-size:27rpx;line-height:1.5}.ach-meta .sub{font-size:22rpx;margin-top:8rpx}.arrow{font-size:36rpx;color:#8cabbd}.bottom-space{height:calc(160rpx + env(safe-area-inset-bottom))}.loading{padding:10rpx 0}.sk-growth-card{height:266rpx;border-radius:32rpx}.sk-growth-card.tall{height:650rpx;margin-top:24rpx}.state{text-align:center}.pill-sky{background:#e8f5fb;color:#1783aa;font-size:21rpx}
@media(max-width:340px){.head .h1{font-size:37rpx}.switch-button{font-size:22rpx;padding:14rpx 16rpx}.progress-card,.radar{padding:24rpx}.dim-grid{gap:10rpx}.dim-chip{padding:18rpx}.dim-name{font-size:23rpx}.dim-v{font-size:30rpx}.radar-canvas{transform:scale(.87);margin:-17px -20px}.progress-number{font-size:48rpx}.progress-card .sub{font-size:21rpx}.brief-question{font-size:31rpx}.brief-heading{gap:7rpx}.brief .h3{font-size:25rpx}.brief-link{font-size:20rpx}.growth-demo{display:none}}
