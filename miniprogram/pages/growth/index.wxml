<public-preview wx:if="{{guest}}" section="growth" signed-in="{{signedIn}}" status-bar-height="{{statusBarHeight}}" />
<view wx:else class="page page-tab growth" style="padding-top: {{statusBarHeight + 44}}px;">
  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}"><view class="pad">
    <view class="head"><view><text class="caption eyebrow">每次探索，都留下回响</text><text class="h1">看见成长</text></view><button class="switch-button" bindtap="openSwitcher">{{data.child.shortName || '选择孩子'}}{{data.child.age ? ' · ' + data.child.age + '岁' : ''}}⌄</button></view>
    <view wx:if="{{loading}}" class="loading"><view class="skeleton sk-growth-card"></view><view class="skeleton sk-growth-card tall"></view></view>
    <view wx:elif="{{error}}" class="card card-p state"><text class="h2">成长记录暂时无法加载</text><text class="sub mt-12">{{error}}</text><button class="btn btn-primary mt-24" bindtap="reload">重新加载</button></view>
    <block wx:else>
      <view class="growth-hero"><image src="/assets/island/robot-island.jpg" mode="aspectFill" /><view class="growth-hero-mask"></view><view class="growth-hero-copy"><text class="hero-kicker">{{data.child.shortName}} · 探索足迹</text><view class="hero-title"><text>每一次发现</text><text>都算数</text></view><text class="hero-sub">{{data.insight.range || '从探索内容与真实记录出发'}}</text><text class="growth-demo">演示数据</text></view></view>
      <button class="brief" data-url="/pages/growth/curiosity" bindtap="go"><view class="between"><view class="brief-heading"><image src="/assets/icons/lucide/sparkles.png" mode="aspectFit" /><text class="h3">成长启思简报</text></view><text class="brief-link">打开简报 ↗</text></view><text class="brief-question">{{data.brief.status === 'ready' ? data.brief.question : '今天的好奇，还在积累'}}</text><text class="sub">{{data.brief.status === 'ready' ? data.brief.date + ' · 追问 ' + data.brief.followups + ' 次' : data.brief.reason || '尚无代表性提问与验证记录，不生成结论。'}}</text></button>
      <view class="progress-card card mt-20">
        <view class="between"><view><text class="h3">探索进度</text><text class="sub">每项内容，首次完成记一次</text></view><text class="progress-number">{{data.progress.completed || 0}}<text> / {{data.progress.total || 29}}</text></text></view>
        <view class="progress-track"><view style="width: {{data.progress.percent || 0}}%"></view></view>
        <view class="between progress-meta"><text class="caption">已解锁不计为完成</text><text class="caption">{{data.progress.percent || 0}}% 已完成{{data.progress.delta > 0 ? ' · 本周新增 ' + data.progress.delta + ' 节' : ''}}</text></view>
        <button class="plan-toggle" bindtap="togglePlan">{{planExpanded ? '收起' : '查看'}}探索计划 · 只读 {{planExpanded ? '⌃' : '⌄'}}</button>
        <view wx:if="{{planExpanded}}" class="plan-list"><view class="lesson" wx:for="{{data.plan}}" wx:key="id"><text class="lesson-id">{{item.id}}</text><view class="lesson-copy"><text>{{item.title}}</text><text class="caption" wx:if="{{item.completedAt}}">{{item.completedAt}} 完成</text></view><text class="lesson-status {{item.status}}">{{item.statusText}}</text></view><text wx:if="{{!data.plan.length}}" class="sub">探索计划尚未提供。</text></view>
      </view>
      <view class="card radar mt-20">
        <view class="between"><text class="h3">六维探索覆盖</text><text class="pill pill-sky">内容覆盖</text></view><text class="sub mt-8">看见探索过的内容。点击维度，回看对应记录。</text>
        <view class="radar-wrap"><canvas class="radar-canvas" canvas-id="growthRadar" aria-label="六维探索覆盖雷达图，详细数值在下方列表"></canvas></view>
        <view class="dim-grid"><button class="dim-chip" wx:for="{{data.dimensions}}" wx:key="key" data-key="{{item.key}}" bindtap="goDim"><text class="dim-name">{{item.name}}</text><text class="dim-v">{{item.insufficient ? '数据不足' : item.value + '%'}}</text><text class="dim-count">{{item.completed}} / {{item.total}} 节 ›</text></button></view>
        <text class="caption radar-note">覆盖比例仅反映内容探索进度，不评价孩子能力。缺少记录时显示“数据不足”。</text><button class="radar-more" data-url="/pages/growth/overview" bindtap="go">查看统计口径与全部维度 ›</button>
      </view>
      <view class="section-block"><view class="section-lead"><text class="section-title">成长报告</text><text class="caption">可以保存脱敏长图</text></view><button class="rep card" wx:for="{{data.reports}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="goReport"><view class="report-icon"><image src="/assets/icons/lucide/document.png" mode="aspectFit" /></view><view class="report-copy"><text class="h3">{{item.title}}</text><text class="sub">{{item.range}}</text></view><text class="report-status">{{item.status === 'generating' ? '生成中' : item.status === 'failed' ? '可重试' : '查看 ›'}}</text></button><view wx:if="{{!data.reports.length}}" class="card card-p"><text class="h3">报告记录尚未生成</text><text class="sub mt-8">有足够探索记录后，再呈现有依据的回顾。</text></view></view>
      <view class="section-block"><view class="section-lead"><text class="section-title">近期成果</text><text class="caption">只读记录</text></view><button class="ach card" wx:for="{{data.achievements}}" wx:key="id" data-id="{{item.id}}" bindtap="goAch"><image class="ach-thumb" src="{{item.image}}" mode="aspectFill" /><view class="ach-meta"><text class="h3">{{item.title}}</text><text class="sub">{{item.time}} · {{item.source}}</text></view><text class="arrow">›</text></button><view wx:if="{{!data.achievements.length}}" class="card card-p"><text class="h3">每一次探索，都值得被记录</text><text class="sub mt-8">完成探索内容或项目后，这里会留下对应成果。</text></view></view>
    </block><view class="bottom-space"></view>
  </view></scroll-view>
  <child-switcher show="{{showSwitcher}}" children="{{children}}" session="{{session}}" current-id="{{data.child.id || ''}}" bind:close="closeSwitcher" bind:change="onChildChange" />
</view>
