@import "./detail-local.wxss";
.curiosity-head{padding:32rpx;border-radius:34rpx;background:#e9f6fc}.curiosity-head .h1{font-size:37rpx;line-height:1.45}.concepts{display:flex;flex-wrap:wrap;gap:12rpx}
.brief-identity{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-bottom:24rpx;font-size:25rpx;font-weight:600}.date-picker{font-size:22rpx;color:#167fa5;padding:12rpx 16rpx;border-radius:17rpx;background:#fff}.editorial-rule{height:3rpx;background:#73bacf;margin:24rpx 0}.brief-theme{font-size:24rpx;color:#4b889f;display:block}.brief-summary{font-size:28rpx;color:#245777;line-height:1.7;display:block}.related-event{width:100%!important;text-align:left;padding:28rpx}.source-link{display:block;font-size:23rpx;color:#1484ad}.report-choices{padding:28rpx;border-radius:30rpx;background:#e9f4fa}.report-choice{display:flex;align-items:center;justify-content:space-between;width:100%!important;padding:22rpx 0;margin:0!important;background:transparent;text-align:left;border-bottom:1rpx solid #d3e8f2;border-radius:0;font-size:25rpx;color:#17658f}.report-choice:last-child{border-bottom:0}.report-choice .caption{margin-top:6rpx;font-size:20rpx}
