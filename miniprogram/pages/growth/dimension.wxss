@import "../../styles/detail.wxss";
.dimension-hero{padding:34rpx;border-radius:42rpx;background:linear-gradient(145deg,#f1edff,#fbf9ff);box-shadow:0 14rpx 36rpx rgba(101,84,184,.1)}.dimension-hero .h1{display:block;margin-top:5rpx}.score{width:108rpx;height:108rpx;border-radius:36rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#7762d5;box-shadow:0 10rpx 28rpx rgba(94,76,172,.11)}.score text:first-child{font-size:42rpx;font-weight:750;line-height:1}.score text:last-child{font-size:20rpx;margin-top:5rpx}.hero-summary{display:block;margin-top:24rpx;font-size:28rpx;line-height:1.55;font-weight:600;color:#243b53}.progress{height:18rpx;margin-top:24rpx;border-radius:99rpx;background:rgba(255,255,255,.8);overflow:hidden}.progress view{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#8874e8,#40b352)}.delta{display:block;margin-top:12rpx;color:#6b7e92;font-size:22rpx}.evidence-card{padding:16rpx 28rpx}.evidence-row{display:flex;align-items:flex-start;gap:18rpx;padding:20rpx 0;color:#40566a;font-size:26rpx;line-height:1.5;border-bottom:1rpx solid #edf1f3}.evidence-row:last-child{border-bottom:0}.evidence-dot{width:16rpx;height:16rpx;margin-top:11rpx;border-radius:50%;background:#40b352;box-shadow:0 0 0 8rpx #e9f8f2;flex:none}.evidence-empty .sub{margin-top:8rpx}.advice{padding:28rpx;display:flex;align-items:flex-start;gap:20rpx;background:linear-gradient(145deg,#eaf6ff,#f8fcff)}.advice-icon{width:70rpx;height:70rpx;border-radius:23rpx;background:#fff;display:flex;align-items:center;justify-content:center;flex:none}.advice-icon image{width:38rpx;height:38rpx}.advice .sub{display:block;margin-top:8rpx}
