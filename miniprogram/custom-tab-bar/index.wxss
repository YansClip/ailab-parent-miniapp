.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(144rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #d9e2ec;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  z-index: 100;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  margin: 0;
  background: transparent;
  line-height: 1.2;
}

.icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.icon-wrap.on {
  background: rgba(64, 179, 82, 0.12);
}

.icon {
  width: 48rpx;
  height: 48rpx;
}

.label {
  font-size: 20rpx;
  color: #829ab1;
}

.label.on {
  color: #40b352;
  font-weight: 500;
}
