.page-has-footer { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

.page-fixed-footer,
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 249, 241, .96);
  border-top: 1rpx solid rgba(16, 42, 67, .06);
}

.card-p { padding: 32rpx; }

.item {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 42, 67, .06);
}

.list-button {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  text-align: left;
  line-height: 1.4;
}
.list-button > text { display: block; }
.list-button > .sub, .list-button > .status { margin-top: 6rpx; }

.danger-inline {
  margin: 0;
  padding: 16rpx;
  background: transparent;
  color: #e85d69;
  font-size: 24rpx;
  line-height: 1;
}

.danger { color: #e85d69; }
.status { font-size: 24rpx; color: #40b352; }

.call-stage { text-align: center; padding: 80rpx 40rpx; }
.big { font-size: 40rpx; font-weight: 700; }
.actions { display: flex; justify-content: center; margin-top: 48rpx; }
.actions > view, .actions > button { margin: 0 16rpx; }
.fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.share-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(16, 42, 67, .4);
  display: flex;
  align-items: flex-end;
}

.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
