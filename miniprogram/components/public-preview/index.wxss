:host{display:block;height:100vh}.public-page{height:100vh;background:linear-gradient(180deg,#eaf5fa,#f5f8fa);box-sizing:border-box}.public-content{padding:0 32rpx;box-sizing:border-box;color:#183b53}.eyebrow{display:block;color:#517e91;font-size:22rpx;letter-spacing:2rpx}.title{display:block;font-size:42rpx;font-weight:700;margin-top:12rpx}.intro{display:block;font-size:26rpx;line-height:1.7;color:#617e8e;margin:20rpx 0 26rpx}.hero{height:300rpx;position:relative;border-radius:32rpx;overflow:hidden}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-shade{background:linear-gradient(180deg,transparent,rgba(16,42,67,.75))}.hero-title{position:absolute;left:26rpx;bottom:76rpx;color:#fff;font-size:35rpx;font-weight:700}.hero-note{position:absolute;left:26rpx;bottom:30rpx;color:#fff;font-size:24rpx}.section-title{display:block;margin:40rpx 0 12rpx;font-size:31rpx;font-weight:700}.small{display:block;font-size:22rpx;line-height:1.65;color:#678393}.note{overflow:hidden;background:#fff;border-radius:30rpx;margin-top:22rpx;border:1rpx solid #dce8ee}.note-button{padding:0;width:100%;background:#fff;text-align:left;line-height:1.5;border-radius:0}.note-button::after,.feature::after,.dimension::after,.text-link::after,.login-button::after{border:0}.note-image{display:block;width:100%;height:330rpx}.note-copy{padding:26rpx}.tag{display:inline-block;color:#287b91;background:#e8f5f7;padding:6rpx 12rpx;border-radius:10rpx;font-size:21rpx}.note-title{display:block;font-weight:650;font-size:29rpx;line-height:1.6;margin-top:10rpx}.note-summary{display:block;color:#617b8a;font-size:25rpx;line-height:1.75;margin-top:12rpx}.link{display:block;color:#157b9d;font-size:25rpx;margin-top:20rpx;font-weight:600}.expanded{padding:26rpx;background:#eaf4f7;color:#365e73;font-size:26rpx;line-height:1.8;border-radius:18rpx;white-space:normal}.feature{width:100%;padding:26rpx;margin:18rpx 0;background:#fff;border:1rpx solid #dde9f0;text-align:left;border-radius:26rpx;line-height:1.5}.brief{padding:28rpx;background:#fff9e7;border-radius:26rpx;margin-top:20rpx}.dimensions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:24rpx 0}.dimension{width:100%;box-sizing:border-box;padding:24rpx 16rpx;min-height:132rpx;margin:0;background:#fff;border-radius:22rpx;text-align:left;font-size:26rpx;color:#224b60;font-weight:600;line-height:1.5}.dimension-link{display:block;font-size:21rpx;color:#718d9c;margin-top:10rpx;font-weight:400}.public-links{display:flex;flex-wrap:wrap;margin:26rpx 0;gap:8rpx}.text-link{width:auto;margin:0;padding:22rpx 12rpx;min-height:88rpx;background:transparent;color:#287b96;line-height:1.5;font-size:24rpx}.login-panel{padding:28rpx;background:#fff;border-radius:28rpx;border:1rpx solid #dce8ee;margin-top:20rpx}.login-button{margin:24rpx 0 14rpx;padding:24rpx;min-height:88rpx;line-height:1.5;width:100%;background:#1684ab;color:#fff;border-radius:22rpx;font-size:28rpx}.bottom-space{height:calc(180rpx + env(safe-area-inset-bottom))}.pressed{opacity:.8}
.feature,.login-button,.note-button,.dimension{display:block;width:100% !important;max-width:none;box-sizing:border-box}
