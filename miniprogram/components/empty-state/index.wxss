.empty {
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 32rpx;
  background: #f0ebff;
  margin-bottom: 16rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #102a43;
  margin-top: 16rpx;
}
.desc {
  font-size: 24rpx;
  color: #61758a;
  line-height: 1.6;
  margin-top: 16rpx;
}
.btn {
  margin-top: 28rpx;
  background: #40b352;
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}
