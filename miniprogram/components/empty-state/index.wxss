.empty {
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.dot {
  width: 260rpx;
  height: 176rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg,#e8f6ff,#edf9fa);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-image { width: 230rpx; height: 160rpx; }
.tone-mint { background: #e9f8f2; color: #40b352; }
.tone-coral { background: #fff0ef; color: #e85d69; }
.tone-sky { background: #eaf6ff; color: #3a8fd4; }
.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #102a43;
  margin-top: 16rpx;
}
.desc {
  font-size: 24rpx;
  color: #61758a;
  line-height: 1.6;
  margin-top: 16rpx;
}
.btn {
  margin-top: 28rpx;
  background: #1487b8;
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}
