.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  background: #f3f9fd;
}
.inner {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
}
.side {
  width: 88rpx !important;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}
.side.right {
  justify-content: flex-end;
}
.back-icon { width: 42rpx; height: 42rpx; margin-left: 8rpx; transform: rotate(180deg); opacity: .72; }
.title {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #102a43;
}
.action {
  font-size: 26rpx;
  color: #197da9;
  padding-right: 12rpx;
}
