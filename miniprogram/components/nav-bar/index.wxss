.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  background: #fff9f1;
}
.inner {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
}
.side {
  width: 120rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}
.side[disabled] { opacity: 1; }
.side.right {
  justify-content: flex-end;
}
.chev {
  font-size: 56rpx;
  color: #102a43;
  padding-left: 12rpx;
  line-height: 1;
}
.title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #102a43;
}
.action {
  font-size: 26rpx;
  color: #8b78e6;
  padding-right: 12rpx;
}
