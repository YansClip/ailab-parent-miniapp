<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="inner" style="height: {{innerHeight}}px; padding-right: {{menuReserved}}px;">
    <button class="side" hover-class="pressed" bindtap="onBack" wx:if="{{back}}" aria-label="返回上一页">
      <image class="back-icon" src="/assets/icons/lucide/chevron.png" mode="aspectFit" />
    </button>
    <view class="side" wx:else></view>
    <text class="title">{{title}}</text>
    <button wx:if="{{action}}" class="side right" hover-class="pressed" bindtap="onAction" aria-label="{{action}}">
      <text class="action">{{action}}</text>
    </button>
    <view wx:else class="side"></view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
