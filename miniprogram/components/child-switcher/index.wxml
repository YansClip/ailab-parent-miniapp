<view class="mask" wx:if="{{show}}" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="handle"></view>
    <text class="title">切换孩子与设备</text>
    <text class="hint">切换后首页、守护、成长会一起刷新，不会短暂显示上一个孩子的数据。</text>
    <view class="item {{item.id === currentId ? 'on' : ''}}" wx:for="{{children}}" wx:key="id" data-id="{{item.id}}" hover-class="pressed" bindtap="onPick">
      <view class="avatar" style="background: {{item.avatarColor}}">{{item.shortName}}</view>
      <view class="meta">
        <text class="name">{{item.name}}</text>
        <text class="dev">{{item.deviceName}} · {{item.online ? '在线' : '离线'}}</text>
      </view>
      <text class="check" wx:if="{{item.id === currentId}}">当前</text>
    </view>
    <view class="cancel" bindtap="onClose">取消</view>
  </view>
</view>
